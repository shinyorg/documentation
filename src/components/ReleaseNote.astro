---

// 'breaking' is accepted as a type as well as the `breaking` flag — both spellings are in use across the
// release notes, so honour either rather than silently dropping the badge.
type WorkType = 'feature' | 'enhancement' | 'fix' | 'chore' | 'breaking';
export interface Props {
    type?: WorkType;
    breaking?: boolean;
    platform?: string;
    githubNumber?: number;
    contributor?: string;
    pr?: boolean;
    repo?: string;
}

const { type, breaking, platform, githubNumber, contributor, pr, repo } = Astro.props as Props;
import { undefined } from 'astro:schema';
import GitHubIssue from './GitHubIssue';
import { Badge } from '@astrojs/starlight/components';

const os = (platform || '').toLowerCase()
const isBreaking = breaking === true || type === 'breaking';
---

<div>
    {
        isBreaking ? <Badge text="BREAKING" variant="danger" /> : ''
    }
    {
        type === 'feature' ? <Badge text="Feature" /> : ''
    }
    {
        type === 'enhancement' ? <Badge text="Enhancement" variant="tip" /> : ''
    }
    {
        type === 'fix' ? <Badge text="Fix" variant="success" /> : ''
    }
    {
        type === 'chore' ? <Badge text="Chore" colour="note" /> : ''
    }
    {
        platform ? <Badge text={platform} variant="note" /> : ''
    }    
    {
        githubNumber != null ? <GitHubIssue repo={repo} number={githubNumber} contributor={contributor} pr={pr} /> : ''
    }
    <div><slot /></div>
</div>