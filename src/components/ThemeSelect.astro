---
// Starlight's ThemeSelect slot is where starlight-blog injects the "Blog" header link.
// We re-render that link ourselves so we can drop the ShinySoft link in beside it,
// then hand off to Starlight's real theme selector.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import StarlightBlogLink from 'starlight-blog/components/ThemeSelect.astro';
---

<StarlightBlogLink><slot /></StarlightBlogLink>

<div class="sponsor-header-link">
  <a
    href="https://sponsor.shinylib.net"
    target="_blank"
    rel="noopener noreferrer"
    title="Sponsor This Project"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.9-9.6-9A5.4 5.4 0 0 1 12 6.1 5.4 5.4 0 0 1 21.6 12c-2.1 4.1-9.6 9-9.6 9Z"/></svg>
    <span>Sponsor This Project</span>
  </a>
</div>

<div class="shinysoft-header-link">
  <a
    href="https://shinysoft.biz"
    target="_blank"
    rel="noopener noreferrer"
    title="ShinySoft Technologies — the company behind Shiny.NET"
  >
    <img src="/images/shinysoft-logo-light.png" alt="ShinySoft Technologies" class="logo-light" />
    <img src="/images/shinysoft-logo-dark.png" alt="ShinySoft Technologies" class="logo-dark" />
  </a>
</div>

<Default><slot /></Default>

<style>
  /* ── Sponsor link ──────────────────────────────────────── */
  .sponsor-header-link {
    border-inline-end: 1px solid var(--sl-color-gray-5);
    display: none;
    padding-inline-end: 1rem;
  }

  .sponsor-header-link a {
    gap: 0.4rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .sponsor-header-link svg {
    color: #E5484D;
    flex-shrink: 0;
  }

  .sponsor-header-link a:hover {
    color: var(--sl-color-text-accent);
    opacity: 1;
  }

  @media (min-width: 50rem) {
    .sponsor-header-link {
      display: flex;
    }
  }

  /* Between 50rem and 72rem the toolbar is tight — show the heart only */
  @media (max-width: 72rem) {
    .sponsor-header-link span {
      display: none;
    }
  }

  /* Matches the sizing/visibility rules starlight-blog uses for its own header link */
  .shinysoft-header-link {
    border-inline-end: 1px solid var(--sl-color-gray-5);
    display: none;
    padding-inline-end: 1rem;
  }

  @media (min-width: 50rem) {
    .shinysoft-header-link {
      display: flex;
    }
  }

  a {
    align-items: center;
    display: inline-flex;
    line-height: 0;
    transition: opacity 0.2s ease;
  }

  a:hover {
    opacity: 0.75;
  }

  img {
    height: auto;
    width: 130px;
  }

  /* The "light" asset is drawn for light backgrounds, "dark" for dark ones */
  .logo-dark,
  :global(:root[data-theme='dark']) .logo-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo-dark {
    display: block;
  }
</style>
