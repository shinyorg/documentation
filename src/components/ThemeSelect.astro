---
// Starlight's ThemeSelect slot is where starlight-blog injects the "Blog" header link.
// We re-render that link ourselves so we can drop the ShinySoft link in beside it,
// then hand off to Starlight's real theme selector.
//
// The "Get Help" icon sits here too, pointing at /foundation/support, and a
// T-shirt icon for the Redbubble merch store (reuses the help link's styling).
//
// The Sponsor link used to sit here as well. It now lives in the homepage hero
// only — the toolbar was carrying more than it could hold between 50rem and
// 72rem, and the ask is easier to make in the hero than in a header icon.
//
// The sparkle button beside the theme selector switches the plasma background
// (`PlasmaBackground.astro`) on and off. The choice is kept in localStorage and
// mirrored to `<html data-plasma="off">`, which this header sets before the
// plasma script runs, so a disabled background never draws a frame.
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
import StarlightBlogLink from 'starlight-blog/components/ThemeSelect.astro';
---

<StarlightBlogLink><slot /></StarlightBlogLink>

<div class="help-header-link">
  <a href="/foundation/support/" title="Get help — Discussions, Discord, issues, commercial support">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M9.4 9.2a2.7 2.7 0 0 1 5.2.9c0 1.8-2.6 2.7-2.6 2.7"/><line x1="12" y1="17" x2="12" y2="17.01"/></svg>
    <span class="sr-only">Get Help</span>
  </a>
</div>

<div class="help-header-link merch-header-link">
  <a href="https://www.redbubble.com/shop/ap/173996199" target="_blank" rel="noopener noreferrer" title="Shiny merch — shirts, stickers, mugs and more">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.4 3.5 16 2a4 4 0 0 1-8 0L3.6 3.5a2 2 0 0 0-1.3 2.2l.6 3.5a1 1 0 0 0 1 .8H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.1a1 1 0 0 0 1-.8l.6-3.5a2 2 0 0 0-1.3-2.2Z"/></svg>
    <span class="sr-only">Merch</span>
  </a>
</div>

<div class="shinysoft-header-link">
  <a
    href="https://shinysoft.biz"
    target="_blank"
    rel="noopener noreferrer"
    title="ShinySoft Technologies — the company behind Shiny.NET"
  >
    <img src="/images/shinysoft-logo-light.png" alt="ShinySoft Technologies" class="logo-light" />
    <img src="/images/shinysoft-logo-dark.png" alt="ShinySoft Technologies" class="logo-dark" />
  </a>
</div>

<div class="help-header-link plasma-header-toggle">
  <button
    type="button"
    data-plasma-toggle
    aria-pressed="true"
    title="Toggle the animated background"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.9L18.7 9.7l-4.9 1.8L12 16.4l-1.8-4.9L5.3 9.7l4.9-1.8z"/><path d="M19 15l.7 1.8 1.8.7-1.8.7L19 20l-.7-1.8-1.8-.7 1.8-.7z"/><line class="plasma-off-slash" x1="3" y1="3" x2="21" y2="21"/></svg>
    <span class="sr-only">Animated background</span>
  </button>
</div>

<script is:inline>
  // Starlight renders ThemeSelect twice (header + mobile menu footer), so this
  // runs once per copy: the guard keeps a single delegated click handler.
  (function () {
    if (window.__plasmaToggle) return;
    window.__plasmaToggle = true;
    var root = document.documentElement;
    try { if (localStorage.getItem('shiny-plasma') === 'off') root.dataset.plasma = 'off'; } catch (e) {}

    function sync() {
      var on = String(root.dataset.plasma !== 'off');
      document.querySelectorAll('[data-plasma-toggle]').forEach(function (b) { b.setAttribute('aria-pressed', on); });
    }
    document.addEventListener('DOMContentLoaded', sync);
    document.addEventListener('click', function (e) {
      if (!e.target.closest || !e.target.closest('[data-plasma-toggle]')) return;
      var off = root.dataset.plasma !== 'off';
      if (off) root.dataset.plasma = 'off';
      else delete root.dataset.plasma;
      try { localStorage.setItem('shiny-plasma', off ? 'off' : 'on'); } catch (e) {}
      sync();
      window.dispatchEvent(new Event('shiny-plasma-change'));
    });
  })();
</script>

<Default><slot /></Default>

<style>
  /* Matches the sizing/visibility rules starlight-blog uses for its own header link */
  .help-header-link,
  .shinysoft-header-link {
    border-inline-end: 1px solid var(--sl-color-gray-5);
    display: none;
    padding-inline-end: 1rem;
  }

  @media (min-width: 50rem) {
    .help-header-link,
    .shinysoft-header-link {
      display: flex;
    }
  }

  /* Icon-only, so it takes the header's own icon sizing rather than the
     130px logo rule below. */
  .help-header-link a,
  .help-header-link button {
    color: var(--sl-color-text-accent);
  }

  .help-header-link a:hover,
  .help-header-link button:hover {
    opacity: 1;
    color: var(--sl-color-white);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  a {
    align-items: center;
    display: inline-flex;
    line-height: 0;
    transition: opacity 0.2s ease;
  }

  a:hover {
    opacity: 0.75;
  }

  button {
    align-items: center;
    display: inline-flex;
    line-height: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  /* Off: dim the sparkle and strike it through */
  .plasma-off-slash {
    display: none;
  }

  button[aria-pressed='false'] {
    opacity: 0.55;
  }

  button[aria-pressed='false'] .plasma-off-slash {
    display: inline;
  }

  img {
    height: auto;
    width: 130px;
  }

  /* The "light" asset is drawn for light backgrounds, "dark" for dark ones */
  .logo-dark,
  :global(:root[data-theme='dark']) .logo-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .logo-dark {
    display: block;
  }
</style>
