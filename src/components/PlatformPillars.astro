---
/**
 * Homepage "one platform" map — the layers of a .NET app the Shiny Platform covers, each linking
 * to its category page with a few of the libraries that carry it. This is the section that backs
 * up the hero's claim, so keep it to layers a reader recognises from their own app, not to our
 * internal category names.
 */
type Pillar = {
  title: string;
  href: string;
  topic: number;
  blurb: string;
  icon: string;
  items: { label: string; href: string }[];
};

const pillars: Pillar[] = [
  {
    title: 'Front end',
    href: '/controls/',
    topic: 9,
    icon: '<rect x="3" y="4" width="18" height="14" rx="2.5"/><path d="M3 9h18M8 21h8"/>',
    blurb: '85+ native controls for .NET MAUI and Blazor on one theme contract, plus source-generated Shell navigation.',
    items: [
      { label: 'UI Controls', href: '/controls/' },
      { label: 'MAUI Shell', href: '/mauishell/' },
      { label: 'Agent UI', href: '/controls/agent-view/' },
    ],
  },
  {
    title: 'Data, offline & cloud',
    href: '/libraries/data/',
    topic: 6,
    icon: '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"/><path d="M4.5 5.5v6.5c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V5.5M4.5 12v6.5c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8V12"/>',
    blurb: 'Document DB across 18 providers, on the device and in the cloud. EF Core extensions for spatial, vector and full-text search, outbox and seeding. Background sync over HTTP.',
    items: [
      { label: 'Document DB', href: '/documentdb/' },
      { label: 'Data Sync', href: '/client/datasync/' },
      { label: 'EF Core', href: '/efcore/' },
      { label: 'Stores', href: '/stores/' },
    ],
  },
  {
    title: 'Communications',
    href: '/client/push/',
    topic: 1,
    icon: '<path d="M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H9l-4.5 3.5V17.5H4A1.5 1.5 0 0 1 2.5 16V7A1.5 1.5 0 0 1 4 5.5Z"/><path d="M7.5 10.5h9M7.5 13.5h5"/>',
    blurb: 'Push and local notifications, typed hubs over Bluetooth and Wi-Fi, background transfers and companion watch apps.',
    items: [
      { label: 'Push', href: '/client/push/' },
      { label: 'Notifications', href: '/client/notifications/' },
      { label: 'Universal Hubs', href: '/universalhubs/' },
      { label: 'HTTP Transfers', href: '/client/httptransfers/' },
      { label: 'Wearables', href: '/client/wearables/' },
    ],
  },
  {
    title: 'Devices & hardware',
    href: '/libraries/hardware/',
    topic: 2,
    icon: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
    blurb: 'Bluetooth, GPS, NFC, beacons, Wi-Fi and printers, plus the data the OS already owns, behind one API per job.',
    items: [
      { label: 'Bluetooth LE', href: '/client/ble/' },
      { label: 'GPS', href: '/client/locations/gps/' },
      { label: 'NFC', href: '/client/nfc/' },
      { label: 'Health', href: '/health/' },
    ],
  },
  {
    title: 'Background work',
    href: '/libraries/background/',
    topic: 4,
    icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
    blurb: 'Jobs the OS schedules, geofences, Live Activities and work that keeps going after the app leaves the screen.',
    items: [
      { label: 'Jobs', href: '/client/jobs/' },
      { label: 'Geofencing', href: '/client/locations/geofencing/' },
      { label: 'Live Activities', href: '/client/liveactivities/' },
    ],
  },
  {
    title: 'AI',
    href: '/libraries/ai/',
    topic: 3,
    icon: '<path d="M12 3.5l1.9 4.6 4.6 1.9-4.6 1.9L12 16.5l-1.9-4.6L5.5 10l4.6-1.9Z"/><path d="M18.5 15.5l.8 1.9 1.9.8-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.8Z"/>',
    blurb: 'Conversations, speech and AI tools generated from the services, routes and data you already have.',
    items: [
      { label: 'AI Conversations', href: '/aiconversation/' },
      { label: 'Speech', href: '/speech/' },
      { label: 'MCP Server', href: '/httpserver/mcp/' },
    ],
  },
  {
    title: 'Back end',
    href: '/libraries/server/',
    topic: 7,
    icon: '<rect x="3.5" y="4" width="17" height="6.5" rx="1.8"/><rect x="3.5" y="13.5" width="17" height="6.5" rx="1.8"/><path d="M7.5 7.25h.01M7.5 16.75h.01"/>',
    blurb: 'An HTTP server that runs anywhere .NET does, ASP.NET Core add-ons, push dispatch, virtual actors, and .NET Aspire integrations for Orleans, databases, VPNs and tunnels.',
    items: [
      { label: 'HTTP Server', href: '/httpserver/' },
      { label: 'ASP.NET', href: '/aspnet/' },
      { label: 'Push Dispatch', href: '/extensions-push/' },
      { label: 'Actors', href: '/actors/' },
      { label: 'Aspire', href: '/aspire/orleans/' },
    ],
  },
  {
    title: 'Foundation',
    href: '/libraries/foundation/',
    topic: 0,
    icon: '<path d="M12 3 3 7.5l9 4.5 9-4.5Z"/><path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/>',
    blurb: 'Hosting, dependency injection, mediator and source generators that keep every layer AOT and trim clean.',
    items: [
      { label: 'Core', href: '/client/core/' },
      { label: 'Mediator', href: '/mediator/' },
      { label: 'DI', href: '/di/' },
    ],
  },
];
---

<div class="pillars not-content" data-stagger="up" data-stagger-step="60">
  {pillars.map((p) => (
    <article class="pillar" data-spotlight style={`--accent: var(--topic-${p.topic})`}>
      <a class="pillar-head" href={p.href}>
        <span class="pillar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
        </span>
        <span class="pillar-title">{p.title}</span>
      </a>
      <p class="pillar-blurb">{p.blurb}</p>
      <ul class="pillar-items">
        {p.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </article>
  ))}
</div>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.25rem 1.25rem 1.1rem;
    border: 1px solid var(--shiny-hairline-strong);
    border-radius: 0.9rem;
    background: var(--shiny-surface);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  /* A thin accent rule in the category's hue, so the grid lines up with the library explorer. */
  .pillar::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
    opacity: 0.85;
  }

  .pillar:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    transform: translateY(-3px);
  }

  .pillar-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--shiny-text-strong);
    text-decoration: none;
  }

  .pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    flex-shrink: 0;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
  }

  :root[data-theme='light'] .pillar-icon {
    color: color-mix(in srgb, var(--accent) 55%, var(--shiny-text-strong));
  }

  .pillar-title {
    font-family: var(--shiny-font-display);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .pillar-head:hover .pillar-title { text-decoration: underline; text-underline-offset: 0.2em; }

  .pillar-blurb {
    margin: 0;
    color: var(--shiny-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .pillar-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: auto 0 0;
    padding: 0.3rem 0 0;
    list-style: none;
  }

  .pillar-items a {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--shiny-hairline-strong);
    border-radius: 999px;
    color: var(--shiny-text);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .pillar-items a:hover {
    border-color: var(--accent);
    color: var(--shiny-text-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar { transition: none; }
    .pillar:hover { transform: none; }
  }
</style>
