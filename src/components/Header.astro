---
// Starlight's header hides its entire `right-group` (socials, theme select and
// our own Sponsor / Blog / ShinySoft links) below 50rem, and splash pages have
// no sidebar — so on mobile the toolbar was left with nothing but the title and
// search. This override keeps the default header and adds a mobile-only
// dropdown carrying everything that would otherwise vanish.
import Default from '@astrojs/starlight/components/Header.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import Finder from './HomepageNav.astro';

// The finder overlay lives here so every page can open it (⌘K, `/`, the
// header's "Browse docs" button). Its floating pill is homepage-only —
// elsewhere the header button is the affordance and the pill would just
// sit on top of the content.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<Default><slot /></Default>

<Finder pill={isHome} />

<div class="mobile-header-menu print:hidden">
  <button
    id="mobile-header-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-header-panel"
    aria-label="More links"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
  </button>

  <div class="mobile-header-panel" id="mobile-header-panel" hidden>
    <button class="mhm-item mhm-browse" type="button" data-open-finder>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.6"/></svg>
      Browse Docs
    </button>
    <a class="mhm-item mhm-sponsor" href="https://sponsor.shinylib.net" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.9-9.6-9A5.4 5.4 0 0 1 12 6.1 5.4 5.4 0 0 1 21.6 12c-2.1 4.1-9.6 9-9.6 9Z"/></svg>
      Sponsor This Project
    </a>
    <a class="mhm-item" href="/blog/">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/></svg>
      Blog
    </a>
    <a class="mhm-item" href="/foundation/appbuilder/">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
      App Builder
    </a>
    <a class="mhm-item" href="https://shinysoft.biz" target="_blank" rel="noopener noreferrer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M10 21v-5h4v5"/></svg>
      ShinySoft
    </a>

    <div class="mhm-footer">
      <div class="mhm-socials"><SocialIcons /></div>
      <ThemeSelect />
    </div>
  </div>
</div>

<style>
  /* Sit in the inline-end padding the header reserves for us below 50rem. */
  .mobile-header-menu {
    display: none;
    position: absolute;
    inset-block: 0;
    inset-inline-end: var(--sl-nav-pad-x);
    align-items: center;
  }

  /* Doc pages already park Starlight's sidebar toggle at the inline end —
     step aside so the two buttons sit side by side. */
  :global(:root[data-has-sidebar]) .mobile-header-menu {
    inset-inline-end: calc(var(--sl-nav-gap) + var(--sl-nav-pad-x) + var(--sl-menu-button-size));
  }

  @media (max-width: 50rem) {
    .mobile-header-menu {
      display: flex;
    }

    /* Reserve room so the dots never land on the search button. */
    :global(header.header) {
      padding-inline-end: calc(var(--sl-nav-pad-x) + var(--sl-menu-button-size) + var(--sl-nav-gap));
    }

    :global(:root[data-has-sidebar] header.header) {
      padding-inline-end: calc(
        var(--sl-nav-pad-x) + (2 * var(--sl-menu-button-size)) + (2 * var(--sl-nav-gap))
      );
    }
  }

  button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    border: 0;
    border-radius: 0.5rem;
    background-color: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }

  button:hover,
  button[aria-expanded='true'] {
    background-color: var(--sl-color-gray-6);
  }

  /* ── Panel ─────────────────────────────────────────────── */
  .mobile-header-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    inset-inline-end: 0;
    z-index: var(--sl-z-index-navbar);
    min-width: 15rem;
    padding: 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background-color: var(--sl-color-bg-nav);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
  }

  .mhm-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    border-radius: 0.4rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }

  .mhm-item:hover {
    background-color: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  /* The scoped `button` rule above sizes the ⋮ toggle — undo it here. */
  .mhm-item.mhm-browse {
    width: 100%;
    height: auto;
    justify-content: flex-start;
    border: 0;
    border-radius: 0.4rem;
    background: none;
    font: inherit;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-align: start;
    cursor: pointer;
  }

  .mhm-browse svg {
    color: var(--shiny-purple-vivid);
  }

  .mhm-sponsor svg {
    color: #E5484D;
  }

  .mhm-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.4rem;
    padding: 0.6rem 0.7rem 0.2rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .mhm-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>

<script>
  (function () {
    var toggle = document.getElementById('mobile-header-toggle');
    var panel = document.getElementById('mobile-header-panel');
    if (!toggle || !panel) return;

    function setOpen(open) {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    }

    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(panel.hidden);
    });

    var browse = panel.querySelector('[data-open-finder]');
    if (browse) browse.addEventListener('click', function () { setOpen(false); });

    document.addEventListener('click', function (e) {
      if (!panel.hidden && !panel.contains(e.target)) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
