---
// Below 50rem Starlight hides its entire header `right-group` (socials, theme
// select, and our own Blog / ShinySoft links), which would leave the mobile
// toolbar with nothing but the title and search.
//
// So on mobile this button opens the finder, which carries the links the right
// group would have shown (see `HomepageNav.astro`). On pages with a sidebar,
// Starlight's own toggle stays too — the finder searches every page, but only
// the sidebar shows where you are in the current section. There the finder
// button steps left of the toggle and swaps its hamburger for a search glyph,
// so the two never read as the same control.
import Default from '@astrojs/starlight/components/Header.astro';
import Finder from './HomepageNav.astro';

// The finder overlay lives here so every page can open it (the header button,
// `/`, the hero button). Its floating pill is homepage-only — elsewhere the
// header button is the affordance and the pill would just sit on the content.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<Default><slot /></Default>

<Finder pill={isHome} />

<div class="mobile-header-menu print:hidden">
  <button
    id="mobile-header-toggle"
    type="button"
    aria-expanded="false"
    aria-label="Menu"
    data-open-finder
    data-finder-anchor="header"
  >
    <svg class="icon-search" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><line x1="16" y1="16" x2="20.5" y2="20.5"/></svg>
    <svg class="icon-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="3.5" y1="6.5" x2="20.5" y2="6.5"/><line x1="3.5" y1="12" x2="20.5" y2="12"/><line x1="3.5" y1="17.5" x2="20.5" y2="17.5"/></svg>
    <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="5.5" y1="5.5" x2="18.5" y2="18.5"/><line x1="18.5" y1="5.5" x2="5.5" y2="18.5"/></svg>
  </button>
</div>

<style>
  /* Pinned to the viewport, exactly like Starlight's toggle: the header
     stretches to the document's scroll width, so an absolutely positioned
     button rides off-screen the moment a page overflows horizontally. */
  .mobile-header-menu {
    display: none;
    position: fixed;
    top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
    inset-inline-end: var(--sl-nav-pad-x);
    z-index: 10;
    align-items: center;
  }

  @media (max-width: 50rem) {
    .mobile-header-menu {
      display: flex;
    }

    /* Splash pages have no sidebar toggle, so this button takes its slot —
       Starlight reserves none there because it renders no toggle of its own. */
    :global(:root:not([data-has-sidebar]) header.header) {
      padding-inline-end: calc(var(--sl-nav-pad-x) + var(--sl-menu-button-size) + var(--sl-nav-gap));
    }

    /* With a sidebar, Starlight's toggle keeps the end slot and this button
       sits just inside it; the header reserves room for both. */
    :global(:root[data-has-sidebar]) .mobile-header-menu {
      inset-inline-end: calc(var(--sl-nav-pad-x) + var(--sl-menu-button-size) + var(--sl-nav-gap));
    }

    :global(:root[data-has-sidebar] header.header) {
      padding-inline-end: calc(var(--sl-nav-pad-x) + 2 * var(--sl-menu-button-size) + 2 * var(--sl-nav-gap));
    }
  }

  button {
    display: grid;
    place-items: center;
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--shiny-menu-button-bg);
    color: #fff;
    cursor: pointer;
    box-shadow: var(--shiny-menu-button-shadow);
    transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.18s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  button:hover {
    transform: translateY(-1px) scale(1.04);
    box-shadow: var(--shiny-menu-button-shadow-strong);
  }

  button:active {
    transform: scale(0.94);
  }

  /* Both glyphs share one cell so the swap doesn't shift the button. The
     finder's own script flips `aria-expanded` on its triggers. */
  button > svg {
    grid-area: 1 / 1;
  }

  .icon-close,
  .icon-search,
  button[aria-expanded='true'] .icon-open,
  button[aria-expanded='true'] .icon-search {
    display: none;
  }

  :global(:root[data-has-sidebar]) button[aria-expanded='false'] .icon-open {
    display: none;
  }

  :global(:root[data-has-sidebar]) button[aria-expanded='false'] .icon-search {
    display: block;
  }

  button[aria-expanded='true'] .icon-close {
    display: block;
  }
</style>
