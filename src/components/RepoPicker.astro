---
/**
 * RepoPicker — "which repo do I file this in?"
 *
 * Shiny is spread over ~20 repos, so the hardest part of reporting a bug is
 * knowing where it goes. Pick the area you're using and this hands back the
 * two links you actually want: search first, then file.
 *
 * `repos` is the source of truth for the docs → GitHub mapping. Each entry's
 * `packages` list is what the repo actually publishes (verified against the
 * repos themselves, not guessed) — it's what people will search this list for.
 * Keep it in sync when a library moves or a new repo appears.
 */

const t = Astro.locals.t;

const ORG = 'shinyorg';

const repos = [
  {
    repo: 'shiny',
    label: t('repoPicker.shinyLabel'),
    packages: 'BluetoothLE, BLE Hosting, Locations, Wi-Fi, Network Discovery, Jobs, Local Notifications, Push, HTTP Transfers, MAUI & Native Hosting, Configuration, Contacts, Calendar, Data Sync, Screen Recording, Live Activities',
  },
  { repo: 'mediator', label: 'Mediator', packages: t('repoPicker.mediatorPackages') },
  {
    repo: 'extensions',
    label: t('repoPicker.extensionsLabel'),
    packages: 'Shiny.Extensions.DependencyInjection, .Reflector, .Serialization, .Stores, .Reactive, .BlazorHosting, .WebHosting, .MauiHosting',
  },
  { repo: 'controls', label: t('repoPicker.controlsLabel'), packages: t('repoPicker.controlsPackages') },
  { repo: 'DocumentDb', label: 'DocumentDb', packages: t('repoPicker.documentDbPackages') },
  { repo: 'geospatialdb', label: t('repoPicker.geospatialdbLabel'), packages: 'Shiny.Spatial, Shiny.Spatial.Geofencing' },
  { repo: 'httpserver', label: 'HTTP Server', packages: t('repoPicker.httpserverPackages') },
  { repo: 'mauishell', label: 'MAUI Shell', packages: 'Shiny.Maui.Shell, Shiny.Maui.Navigation, Shiny.Maui.Core' },
  { repo: 'speech', label: t('repoPicker.speechLabel'), packages: t('repoPicker.speechPackages') },
  { repo: 'recogintelligence', label: t('repoPicker.recogintelligenceLabel'), packages: 'Shiny.FaceIntelligence, Shiny.VoiceIntelligence, Shiny.DocumentIntelligence' },
  { repo: 'obd', label: 'OBD', packages: 'Shiny.Obd, Shiny.Obd.Ble, Shiny.Obd.Serial, Shiny.Obd.Wifi' },
  { repo: 'music', label: 'Music', packages: 'Shiny.Music, Shiny.Spotify.Maui' },
  { repo: 'Health', label: 'Health', packages: 'Shiny.Health' },
  { repo: 'aspire', label: t('repoPicker.aspireLabel'), packages: 'Shiny.Aspire.Orleans.*, Shiny.Aspire.Hosting.Tunnel.*' },
  { repo: 'firebase', label: t('repoPicker.firebaseLabel'), packages: t('repoPicker.firebasePackages') },
  { repo: 'pushextensions', label: t('repoPicker.pushextensionsLabel'), packages: 'Shiny.Extensions.Push, Shiny.Extensions.Push.DocumentDb' },
  { repo: 'msbuildpermissions', label: t('repoPicker.msbuildpermissionsLabel'), packages: 'Shiny.Permissions.MSBuild' },
  { repo: 'localizegen', label: t('repoPicker.localizegenLabel'), packages: 'Shiny.Extensions.Localization.Generator' },
  { repo: 'mauiplatforms', label: t('repoPicker.mauiplatformsLabel'), packages: 'Platform.Maui.TvOS, Platform.Maui.MacOS' },
  { repo: 'templates', label: t('repoPicker.templatesLabel'), packages: 'Shiny.Templates' },
  { repo: 'skills', label: t('repoPicker.skillsLabel'), packages: t('repoPicker.skillsPackages') },
  { repo: 'documentation', label: t('repoPicker.documentationLabel'), packages: t('repoPicker.documentationPackages') },
];

const first = repos[0];
---

<div class="repo-picker not-content" data-org={ORG}>
  <label class="repo-picker-label" for="repo-picker-select">{t('repoPicker.whatAreYouUsing')}</label>

  <div class="repo-picker-row">
    <select id="repo-picker-select" class="repo-picker-select">
      {repos.map((r) => (
        <option value={r.repo} data-packages={r.packages}>{r.label}</option>
      ))}
    </select>

    <div class="repo-picker-actions">
      <a
        id="repo-picker-search"
        class="repo-picker-btn"
        href={`https://github.com/${ORG}/${first.repo}/issues`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('repoPicker.searchIssues')}
      </a>
      <a
        id="repo-picker-new"
        class="repo-picker-btn repo-picker-btn--primary"
        href={`https://github.com/${ORG}/${first.repo}/issues/new`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('repoPicker.openIssue')}
      </a>
    </div>
  </div>

  <p class="repo-picker-hint">
    <span class="repo-picker-repo">
      <code id="repo-picker-name">{ORG}/{first.repo}</code>
    </span>
    <span id="repo-picker-packages">{first.packages}</span>
  </p>

  <details class="repo-picker-all">
    <summary>{t('repoPicker.browseAll')}</summary>
    <table>
      <thead>
        <tr><th>{t('repoPicker.areaHeading')}</th><th>{t('repoPicker.repositoryHeading')}</th></tr>
      </thead>
      <tbody>
        {repos.map((r) => (
          <tr>
            <td>{r.label}</td>
            <td>
              <a href={`https://github.com/${ORG}/${r.repo}`} target="_blank" rel="noopener noreferrer">
                {ORG}/{r.repo}
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</div>

<style>
  .repo-picker {
    margin: 1.25rem 0 2rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-bg-nav);
  }

  .repo-picker-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--sl-color-white);
    font-size: 0.92rem;
    font-weight: 650;
  }

  .repo-picker-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .repo-picker-select {
    flex: 1 1 20rem;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: 0.9rem;
  }

  .repo-picker-select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .repo-picker-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .repo-picker-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .repo-picker-btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }

  .repo-picker-btn--primary {
    border-color: transparent;
    background: linear-gradient(118deg, var(--shiny-purple-vivid), var(--shiny-green-vivid));
    color: #fff;
  }

  .repo-picker-btn--primary:hover {
    color: #fff;
    filter: brightness(1.08);
  }

  .repo-picker-hint {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .repo-picker-repo {
    display: block;
    margin-bottom: 0.2rem;
  }

  .repo-picker-hint code {
    font-size: 0.8rem;
    color: var(--sl-color-text-accent);
  }

  .repo-picker-all {
    margin-top: 0.9rem;
    border-top: 1px solid var(--sl-color-gray-6);
    padding-top: 0.7rem;
  }

  .repo-picker-all summary {
    color: var(--sl-color-text-accent);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .repo-picker-all table {
    width: 100%;
    margin-top: 0.7rem;
    font-size: 0.85rem;
  }
</style>

<script>
  (function () {
    const root = document.querySelector<HTMLElement>('.repo-picker');
    const select = document.getElementById('repo-picker-select') as HTMLSelectElement | null;
    const search = document.getElementById('repo-picker-search') as HTMLAnchorElement | null;
    const create = document.getElementById('repo-picker-new') as HTMLAnchorElement | null;
    const packages = document.getElementById('repo-picker-packages');
    const name = document.getElementById('repo-picker-name');
    if (!root || !select || !search || !create || !packages || !name) return;

    const org = root.dataset.org;

    function sync() {
      const option = select.selectedOptions[0];
      const repo = select.value;
      search.href = `https://github.com/${org}/${repo}/issues`;
      create.href = `https://github.com/${org}/${repo}/issues/new`;
      packages.textContent = option?.dataset.packages ?? '';
      name.textContent = `${org}/${repo}`;
    }

    select.addEventListener('change', sync);
    // A bfcache restore or a browser-remembered selection can leave the select
    // on a different option than the one the server rendered the links for.
    sync();
  })();
</script>
