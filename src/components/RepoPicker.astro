---
/**
 * RepoPicker — "which repo do I file this in?"
 *
 * Shiny is spread over ~20 repos, so the hardest part of reporting a bug is
 * knowing where it goes. Pick the area you're using and this hands back the
 * two links you actually want: search first, then file.
 *
 * `repos` is the source of truth for the docs → GitHub mapping. Each entry's
 * `packages` list is what the repo actually publishes (verified against the
 * repos themselves, not guessed) — it's what people will search this list for.
 * Keep it in sync when a library moves or a new repo appears.
 */

const ORG = 'shinyorg';

const repos = [
  {
    repo: 'shiny',
    label: 'Shiny Core — device & background services',
    packages: 'BluetoothLE, BLE Hosting, Locations, Wi-Fi, Network Discovery, Jobs, Local Notifications, Push, HTTP Transfers, MAUI & Native Hosting, Configuration, Contacts, Calendar, Data Sync, Screen Recording, Live Activities',
  },
  { repo: 'mediator', label: 'Mediator', packages: 'Shiny.Mediator and all of its middleware, HTTP, and source-generator packages' },
  {
    repo: 'extensions',
    label: 'Extensions — DI, Reflector, Serialization, Stores',
    packages: 'Shiny.Extensions.DependencyInjection, .Reflector, .Serialization, .Stores, .Reactive, .BlazorHosting, .WebHosting, .MauiHosting',
  },
  { repo: 'controls', label: 'UI Controls (MAUI & Blazor)', packages: 'Shiny.Maui.Controls.*, Shiny.Blazor.Controls.*, themes, camera, barcodes, office, media element' },
  { repo: 'DocumentDb', label: 'DocumentDb', packages: 'Shiny.DocumentDb and every provider (Sqlite, Postgres, Mongo, Cosmos, Redis, Orleans, …)' },
  { repo: 'geospatialdb', label: 'Spatial & Geofencing', packages: 'Shiny.Spatial, Shiny.Spatial.Geofencing' },
  { repo: 'httpserver', label: 'HTTP Server', packages: 'Shiny.Net.HttpServer and its tunnels, gRPC, WebDav, MCP, and JWT packages' },
  { repo: 'mauishell', label: 'MAUI Shell', packages: 'Shiny.Maui.Shell, Shiny.Maui.Navigation, Shiny.Maui.Core' },
  { repo: 'speech', label: 'Speech & AI Conversation', packages: 'Shiny.Speech, Shiny.AiConversation, Shiny.Audio and their providers' },
  { repo: 'recogintelligence', label: 'Face, Voice & Document Intelligence', packages: 'Shiny.FaceIntelligence, Shiny.VoiceIntelligence, Shiny.DocumentIntelligence' },
  { repo: 'obd', label: 'OBD', packages: 'Shiny.Obd, Shiny.Obd.Ble, Shiny.Obd.Serial, Shiny.Obd.Wifi' },
  { repo: 'music', label: 'Music', packages: 'Shiny.Music, Shiny.Spotify.Maui' },
  { repo: 'Health', label: 'Health', packages: 'Shiny.Health' },
  { repo: 'aspire', label: 'Aspire — Orleans & tunnels', packages: 'Shiny.Aspire.Orleans.*, Shiny.Aspire.Hosting.Tunnel.*' },
  { repo: 'firebase', label: 'Firebase — Firestore & FCM', packages: 'Shiny.DocumentDb.Firestore.Mobile, Shiny.Push.FirebaseMessaging, iOS/Android bindings' },
  { repo: 'pushextensions', label: 'Push (server side)', packages: 'Shiny.Extensions.Push, Shiny.Extensions.Push.DocumentDb' },
  { repo: 'msbuildpermissions', label: 'MSBuild Permissions', packages: 'Shiny.Permissions.MSBuild' },
  { repo: 'localizegen', label: 'Localization Generator', packages: 'Shiny.Extensions.Localization.Generator' },
  { repo: 'mauiplatforms', label: 'MAUI for tvOS & macOS', packages: 'Platform.Maui.TvOS, Platform.Maui.MacOS' },
  { repo: 'templates', label: 'Project templates (dotnet new)', packages: 'Shiny.Templates' },
  { repo: 'skills', label: 'AI Skills', packages: 'The agent skills for Shiny libraries' },
  { repo: 'documentation', label: 'This documentation site', packages: 'Anything wrong, missing, or unclear on shinylib.net' },
];

const first = repos[0];
---

<div class="repo-picker not-content" data-org={ORG}>
  <label class="repo-picker-label" for="repo-picker-select">What are you using?</label>

  <div class="repo-picker-row">
    <select id="repo-picker-select" class="repo-picker-select">
      {repos.map((r) => (
        <option value={r.repo} data-packages={r.packages}>{r.label}</option>
      ))}
    </select>

    <div class="repo-picker-actions">
      <a
        id="repo-picker-search"
        class="repo-picker-btn"
        href={`https://github.com/${ORG}/${first.repo}/issues`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Search existing issues
      </a>
      <a
        id="repo-picker-new"
        class="repo-picker-btn repo-picker-btn--primary"
        href={`https://github.com/${ORG}/${first.repo}/issues/new`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Open a new issue
      </a>
    </div>
  </div>

  <p class="repo-picker-hint">
    <span class="repo-picker-repo">
      <code id="repo-picker-name">{ORG}/{first.repo}</code>
    </span>
    <span id="repo-picker-packages">{first.packages}</span>
  </p>

  <details class="repo-picker-all">
    <summary>Or browse the full list</summary>
    <table>
      <thead>
        <tr><th>Area</th><th>Repository</th></tr>
      </thead>
      <tbody>
        {repos.map((r) => (
          <tr>
            <td>{r.label}</td>
            <td>
              <a href={`https://github.com/${ORG}/${r.repo}`} target="_blank" rel="noopener noreferrer">
                {ORG}/{r.repo}
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</div>

<style>
  .repo-picker {
    margin: 1.25rem 0 2rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-bg-nav);
  }

  .repo-picker-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--sl-color-white);
    font-size: 0.92rem;
    font-weight: 650;
  }

  .repo-picker-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .repo-picker-select {
    flex: 1 1 20rem;
    min-width: 0;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: 0.9rem;
  }

  .repo-picker-select:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 1px;
  }

  .repo-picker-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .repo-picker-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-white);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .repo-picker-btn:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }

  .repo-picker-btn--primary {
    border-color: transparent;
    background: linear-gradient(118deg, var(--shiny-purple-vivid), var(--shiny-green-vivid));
    color: #fff;
  }

  .repo-picker-btn--primary:hover {
    color: #fff;
    filter: brightness(1.08);
  }

  .repo-picker-hint {
    margin: 0.75rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .repo-picker-repo {
    display: block;
    margin-bottom: 0.2rem;
  }

  .repo-picker-hint code {
    font-size: 0.8rem;
    color: var(--sl-color-text-accent);
  }

  .repo-picker-all {
    margin-top: 0.9rem;
    border-top: 1px solid var(--sl-color-gray-6);
    padding-top: 0.7rem;
  }

  .repo-picker-all summary {
    color: var(--sl-color-text-accent);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }

  .repo-picker-all table {
    width: 100%;
    margin-top: 0.7rem;
    font-size: 0.85rem;
  }
</style>

<script>
  (function () {
    const root = document.querySelector<HTMLElement>('.repo-picker');
    const select = document.getElementById('repo-picker-select') as HTMLSelectElement | null;
    const search = document.getElementById('repo-picker-search') as HTMLAnchorElement | null;
    const create = document.getElementById('repo-picker-new') as HTMLAnchorElement | null;
    const packages = document.getElementById('repo-picker-packages');
    const name = document.getElementById('repo-picker-name');
    if (!root || !select || !search || !create || !packages || !name) return;

    const org = root.dataset.org;

    function sync() {
      const option = select.selectedOptions[0];
      const repo = select.value;
      search.href = `https://github.com/${org}/${repo}/issues`;
      create.href = `https://github.com/${org}/${repo}/issues/new`;
      packages.textContent = option?.dataset.packages ?? '';
      name.textContent = `${org}/${repo}`;
    }

    select.addEventListener('change', sync);
    // A bfcache restore or a browser-remembered selection can leave the select
    // on a different option than the one the server rendered the links for.
    sync();
  })();
</script>
