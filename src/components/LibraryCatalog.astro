---
/**
 * A category landing page — what every library in the category does, and where to go next.
 * Used by `src/content/docs/libraries/<slug>.mdx`. Copy lives in `src/data/libraryCatalog.ts`.
 */
import { Icon } from '@astrojs/starlight/components';
import PlatformSupport from './PlatformSupport.astro';
import DatabaseProviders from './DatabaseProviders/DatabaseProviders.astro';
import { getCatalog, getCategory, inlineCode } from '../data/libraryCatalog';
import { localeHref } from '../i18n/url';
import { localizedLabel } from '../i18n/label';

export interface Props {
  category: string;
}

const cat = getCategory(Astro.props.category);
const others = getCatalog().filter((c) => c.slug !== cat.slug);
const anchor = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const t = Astro.locals.t;
const locale = Astro.locals.starlightRoute?.locale;
const lang = locale ? Astro.locals.starlightRoute.lang : undefined;
const href = (path: string) => localeHref(path, locale);
const label = (text: string) => localizedLabel(text, lang);
const libraryCount = (count: number) => t('libraryCatalog.libraryCount').replace('{count}', String(count));
---

<div class="lc not-content" style={`--lxl:${cat.accent};--lxd:${cat.accentDark}`}>
  <p class="lc-intro" set:html={inlineCode(cat.intro)} />

  {cat.resources && (
    <div class="lc-chips">
      <span class="lc-chips-label">{t('libraryCatalog.startHere')}</span>
      {cat.resources.map((r) => <a class="lc-chip" href={href(r.href)}>{label(r.label)}</a>)}
    </div>
  )}

  <nav class="lc-chips lc-jump" aria-label={t('libraryCatalog.categoryLibrariesAria').replace('{category}', label(cat.label))}>
    <span class="lc-chips-label">{libraryCount(cat.libraries.length)}</span>
    {cat.libraries.map((lib) => <a class="lc-chip" href={`#${anchor(lib.label)}`}>{label(lib.label)}</a>)}
  </nav>

  {cat.libraries.map((lib) => (
    <article class="lc-lib" id={anchor(lib.label)}>
      <header class="lc-lib-head">
        <div class="lc-lib-titles">
          <h2 class="lc-lib-name"><a href={href(lib.href)}>{label(lib.label)}</a></h2>
          <p class="lc-lib-tag" set:html={inlineCode(lib.tagline)} />
        </div>
        <a class="lc-cta" href={href(lib.href)}>{t('libraryCatalog.getStarted')} <Icon name="right-arrow" /></a>
      </header>

      <div class="lc-lib-body">
        <div class="lc-main">
          <p class="lc-summary" set:html={inlineCode(lib.summary)} />
          <ul class="lc-highlights">
            {lib.highlights.map((h) => (
              <li>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                <span set:html={inlineCode(h)} />
              </li>
            ))}
          </ul>
          {lib.label === 'Document DB' && <DatabaseProviders variant="compact" />}
        </div>

        <aside class="lc-meta">
          {(lib.frameworks || lib.os) && <PlatformSupport frameworks={lib.frameworks} os={lib.os} />}

          <div class="lc-meta-block">
            <span class="lc-meta-label">NuGet</span>
            <ul class="lc-pkgs">
              {lib.packages.map((p) => (
                <li><a href={`https://www.nuget.org/packages/${p}`} target="_blank" rel="noopener noreferrer"><code>{p}</code></a></li>
              ))}
            </ul>
          </div>

          {lib.links.length > 0 && (
            <div class="lc-meta-block">
              <span class="lc-meta-label">{t('libraryCatalog.inTheDocs')}</span>
              <ul class="lc-links">
                {lib.links.map((l) => <li><a href={href(l.href)}>{label(l.label)}</a></li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </article>
  ))}

  <nav class="lc-others" aria-label={t('libraryCatalog.otherCategoriesAria')}>
    <span class="lc-chips-label">{t('libraryCatalog.moreFromShiny')}</span>
    <div class="lc-others-grid">
      {others.map((o) => (
        <a class="lc-other" href={href(o.page)} style={`--lxl:${o.accent};--lxd:${o.accentDark}`}>
          <span class="lc-other-icon"><Icon name={o.icon} /></span>
          <span class="lc-other-text">
            <span class="lc-other-name">{label(o.label)}</span>
            <span class="lc-other-count">{o.libraries.length ? libraryCount(o.libraries.length) : t('libraryCatalog.controlsCount')}</span>
          </span>
        </a>
      ))}
    </div>
  </nav>
</div>

<style>
  .lc {
    --lx: var(--lxl);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(:root[data-theme='dark']) .lc,
  :global(:root[data-theme='dark']) .lc-other {
    --lx: var(--lxd);
  }

  .lc-intro {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .lc-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .lc-chips-label {
    margin-right: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .lc-chip {
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--lx) 30%, var(--sl-color-gray-6));
    background: color-mix(in srgb, var(--lx) 7%, transparent);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .lc-chip:hover,
  .lc-chip:focus-visible {
    border-color: var(--lx);
    background: color-mix(in srgb, var(--lx) 16%, transparent);
  }

  .lc-jump {
    padding-bottom: 0.5rem;
  }

  .lc-lib {
    scroll-margin-top: calc(var(--sl-nav-height, 3.5rem) + 1.5rem);
    padding: 1.4rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-6);
    border-left: 4px solid var(--lx);
    background: var(--sl-color-bg);
  }

  :global(:root[data-theme='dark']) .lc-lib {
    border-color: var(--sl-color-gray-5);
    border-left-color: var(--lx);
    background: rgba(255, 255, 255, 0.03);
  }

  .lc-lib-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
  }

  .lc-lib-titles {
    min-width: 0;
    flex: 1 1 18rem;
  }

  .lc-lib-name {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .lc-lib-name a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .lc-lib-name a:hover {
    color: var(--lx);
  }

  .lc-lib-tag {
    margin: 0.3rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--lx);
  }

  .lc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
    padding: 0.5rem 0.95rem;
    border-radius: 0.6rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    background: var(--lx);
    text-decoration: none;
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  :global(:root[data-theme='dark']) .lc-cta {
    color: var(--sl-color-black);
  }

  .lc-cta:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .lc-lib-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
    gap: 1.5rem;
  }

  @media (max-width: 60rem) {
    .lc-lib-body {
      grid-template-columns: 1fr;
    }
  }

  .lc-summary {
    margin: 0 0 0.9rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .lc-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .lc-highlights li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
    line-height: 1.5;
    color: var(--sl-color-white);
  }

  .lc-highlights svg {
    flex-shrink: 0;
    margin-top: 0.22rem;
    color: var(--lx);
  }

  .lc-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--sl-color-hairline);
  }

  @media (max-width: 60rem) {
    .lc-meta {
      padding-left: 0;
      padding-top: 1rem;
      border-left: none;
      border-top: 1px solid var(--sl-color-hairline);
    }
  }

  /* PlatformSupport carries its own margins for use in prose; tighten it inside the sidebar column */
  .lc-meta :global(.platform-support-container) {
    margin: 0;
    gap: 0.75rem;
  }

  .lc-meta :global(.platform-support-row) {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .lc-meta :global(.platform-support__heading) {
    min-width: 0;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
  }

  .lc-meta :global(.platform-support) {
    gap: 0.3rem;
  }

  .lc-meta :global(.platform-support__item) {
    min-width: 0;
    gap: 0.3rem;
    padding: 0.18rem 0.55rem;
    font-size: 0.8rem;
  }

  .lc-meta :global(.platform-support__icon) {
    width: 14px;
    height: 14px;
  }

  .lc-meta-block {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .lc-meta-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .lc-pkgs,
  .lc-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lc-pkgs a {
    text-decoration: none;
  }

  .lc-pkgs code {
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  .lc-links a {
    font-size: 0.9rem;
    color: var(--sl-color-text-accent);
  }

  .lc-others {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lc-others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 0.6rem;
  }

  .lc-other {
    --lx: var(--lxl);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.8rem;
    border-radius: 0.75rem;
    border: 1px solid var(--sl-color-gray-6);
    color: inherit;
    text-decoration: none;
  }

  .lc-other:hover {
    border-color: var(--lx);
    background: color-mix(in srgb, var(--lx) 7%, transparent);
  }

  .lc-other-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.55rem;
    color: #fff;
    background: var(--lx);
  }

  :global(:root[data-theme='dark']) .lc-other-icon {
    color: var(--sl-color-black);
  }

  .lc-other-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .lc-other-name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--sl-color-white);
  }

  .lc-other-count {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .lc-cta { transition: none; }
    .lc-cta:hover { transform: none; }
  }
</style>
