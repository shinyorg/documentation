---
/**
 * Homepage library explorer — every category, every library, one line each.
 *
 * Data: `src/data/libraryCatalog.ts` (copy) joined with `src/sidebar-topics.mjs` (structure).
 * Each panel keeps its topic's finder accent, so a category is the same colour in the finder,
 * here, and on its own page.
 */
import { Icon } from '@astrojs/starlight/components';
import DatabaseProviders from './DatabaseProviders/DatabaseProviders.astro';
import { getCatalog, inlineCode } from '../data/libraryCatalog';
import { localeHref } from '../i18n/url';
import { localizedLabel } from '../i18n/label';

const t = Astro.locals.t;
const locale = Astro.locals.starlightRoute?.locale;
const lang = locale ? Astro.locals.starlightRoute.lang : undefined;
const catalog = getCatalog();
---

<div class="library-explorer not-content" data-stagger="up" data-stagger-step="80">
  {catalog.map((cat) => {
    const isFeatured = cat.libraries.length === 0;
    return (
      <section
        class:list={['lx-panel', { 'lx-panel--wide': isFeatured }]}
        data-spotlight
        style={`--lxl:${cat.accent};--lxd:${cat.accentDark}`}
      >
        <a class="lx-head" href={localeHref(cat.page, locale)}>
          <span class="lx-icon"><Icon name={cat.icon} /></span>
          <span class="lx-title">{localizedLabel(cat.label, lang)}</span>
          {!isFeatured && <span class="lx-count">{t('libraryExplorer.libraryCount').replace('{count}', String(cat.libraries.length))}</span>}
        </a>

        <p class="lx-headline">{cat.headline}</p>

        {cat.resources && (
          <div class="lx-chips lx-chips--quiet">
            <span class="lx-chips-label">{t('libraryExplorer.startHere')}</span>
            {cat.resources.map((r) => <a class="lx-chip" href={localeHref(r.href, locale)}>{localizedLabel(r.label, lang)}</a>)}
          </div>
        )}

        {!isFeatured && (
          <ul class="lx-list">
            {cat.libraries.map((lib) => (
              <li>
                <a class="lx-lib" href={localeHref(lib.href, locale)}>
                  <span class="lx-lib-name">{localizedLabel(lib.label, lang)}</span>
                  <span class="lx-lib-tag" set:html={inlineCode(lib.tagline)} />
                </a>
              </li>
            ))}
          </ul>
        )}

        {cat.featured && (
          <div class="lx-chips">
            {cat.featured.map((f) => <a class="lx-chip" href={localeHref(f.href, locale)}>{localizedLabel(f.label, lang)}</a>)}
          </div>
        )}

        {cat.slug === 'data' && <DatabaseProviders variant="compact" />}

        <a class="lx-more" href={localeHref(cat.page, locale)}>
          {isFeatured ? t('libraryExplorer.browseEveryControl') : t('libraryExplorer.exploreCategory').replace('{label}', localizedLabel(cat.label, lang))}
          <Icon name="right-arrow" />
        </a>
      </section>
    );
  })}
</div>

<style>
  .library-explorer {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .lx-panel {
    --lx: var(--lxl);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.35rem 1.4rem 1.2rem;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-6);
    border-top: 3px solid var(--lx);
    background: linear-gradient(180deg, color-mix(in srgb, var(--lx) 6%, var(--sl-color-bg)) 0%, var(--sl-color-bg) 9rem);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  :global(:root[data-theme='dark']) .lx-panel {
    --lx: var(--lxd);
    border-color: var(--sl-color-gray-5);
    border-top-color: var(--lx);
    background: linear-gradient(180deg, color-mix(in srgb, var(--lx) 9%, transparent) 0%, rgba(255, 255, 255, 0.02) 9rem);
  }

  .lx-panel:hover {
    box-shadow: 0 10px 30px color-mix(in srgb, var(--lx) 16%, transparent);
  }

  .lx-panel--wide {
    grid-column: 1 / -1;
  }

  .lx-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
    text-decoration: none;
  }

  .lx-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.7rem;
    font-size: 1.2rem;
    color: #fff;
    background: var(--lx);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--lx) 40%, transparent);
  }

  :global(:root[data-theme='dark']) .lx-icon {
    color: var(--sl-color-black);
  }

  .lx-title {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .lx-head:hover .lx-title {
    color: var(--lx);
  }

  .lx-count {
    margin-left: auto;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--lx);
    background: color-mix(in srgb, var(--lx) 12%, transparent);
  }

  .lx-headline {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .lx-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .lx-list li + li {
    border-top: 1px solid var(--sl-color-hairline);
  }

  .lx-lib {
    display: grid;
    grid-template-columns: minmax(7.5rem, 32%) 1fr;
    gap: 0.2rem 0.9rem;
    padding: 0.5rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .lx-lib:hover,
  .lx-lib:focus-visible {
    background: color-mix(in srgb, var(--lx) 9%, transparent);
  }

  .lx-lib-name {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--sl-color-white);
  }

  .lx-lib:hover .lx-lib-name {
    color: var(--lx);
  }

  .lx-lib-tag {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--sl-color-gray-3);
  }

  .lx-lib-tag :global(code) {
    font-size: 0.8em;
  }

  @media (max-width: 30rem) {
    .lx-lib {
      grid-template-columns: 1fr;
    }
  }

  .lx-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .lx-chips-label {
    margin-right: 0.2rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .lx-chip {
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--lx) 30%, var(--sl-color-gray-6));
    background: color-mix(in srgb, var(--lx) 7%, transparent);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .lx-chip:hover,
  .lx-chip:focus-visible {
    border-color: var(--lx);
    background: color-mix(in srgb, var(--lx) 16%, transparent);
  }

  .lx-chips--quiet .lx-chip {
    font-weight: 500;
  }

  .lx-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.2rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--lx);
    text-decoration: none;
  }

  .lx-more :global(svg) {
    transition: transform 0.2s ease;
  }

  .lx-more:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .lx-panel, .lx-chip, .lx-more :global(svg) { transition: none; }
  }
</style>
