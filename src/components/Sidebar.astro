---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import TopicsDropdown from 'starlight-sidebar-topics-dropdown/TopicsDropdown.astro';
// Local fork of Starlight's SidebarSublist so an entry can carry a second "platform" pill
// (MAUI / Blazor) alongside its normal badge.
import SidebarSublist from './SidebarSublist.astro';

// Blog (and any other pages excluded from sidebar-topics) have no current
// topic, which makes TopicsDropdown crash at `currentTopic.icon`. Only render
// the dropdown when a current topic is available.
const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
const hasCurrentTopic = topics.some((topic) => topic.isCurrent);

const { sidebar } = Astro.locals.starlightRoute;
---

{/* Render the topics dropdown menu — only when a current topic exists. */}
{hasCurrentTopic && <TopicsDropdown />}

{/* Body of Starlight's own Sidebar, with our SidebarSublist swapped in. */}
<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>
