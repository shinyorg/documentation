---
/**
 * Frames the live Theme Composer, which runs in the Blazor playground rather than here.
 *
 * The composer's canvas is a page of *real* Shiny controls reading the same tokens your app would.
 * Re-implementing that on this site is what the previous Theme Creator tried: a React island that
 * mirrored the C# generator in TypeScript, with hand-built mock-ups standing in for the controls. It
 * drifted from the generator, shipped three of the five packs, and not one actual control ever
 * rendered in it. Embedding the real thing cannot drift, because it *is* the library.
 */
export interface Props {
    /** A `?preset=` code to open on. Omit for the default design. */
    preset?: string;
    /** Height of the frame. The composer docks its controls to the bottom, so give it room. */
    height?: string;
}

const { preset, height = '760px' } = Astro.props as Props;

const base = 'https://shinyorg.github.io/controls/themes';
const src = preset ? `${base}?preset=${preset}` : base;

/**
 * Starting points, as preset codes. A code is one base-36 character per knob - pack, accent, radius,
 * density, text scale, font, weight - and a trailing `l`/`d` for the scheme. The lists behind those
 * indexes are append-only, so a code minted today keeps resolving to the same design.
 */
const presets = [
    { code: '0000000l', label: 'Basic' },
    { code: '0253000l', label: 'Violet, pill' },
    { code: '1000000d', label: 'Ocean dark' },
    { code: '2530300l', label: 'Material amber' },
    { code: '3010030l', label: 'Terminal mono' },
    { code: '4640000d', label: 'Aurora rose' }
];
---

<div class="composer-embed">
    <div class="composer-embed__bar">
        <div class="composer-embed__presets">
            {presets.map(p => (
                <button type="button" class="composer-embed__chip" data-preset={p.code}>{p.label}</button>
            ))}
        </div>
        <a class="composer-embed__pop" href={src} target="_blank" rel="noopener noreferrer">Open full screen &#8599;</a>
    </div>

    <iframe
        class="composer-embed__frame"
        src={src}
        style={`height: ${height}`}
        title="Shiny Controls Theme Composer"
        loading="lazy"
        sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
    ></iframe>

    <p class="composer-embed__note">
        Everything on the canvas is a real Shiny control. Change a knob and it re-skins live, then take
        the CSS or the XAML with you.
    </p>
</div>

<script>
    // Swapping src reloads the app; the composer reads ?preset= on start, so the design comes back
    // exactly. Chips are progressive enhancement - each one is also a plain link target via the
    // full-screen anchor if scripting is off.
    document.querySelectorAll<HTMLElement>('.composer-embed').forEach(host => {
        const frame = host.querySelector<HTMLIFrameElement>('.composer-embed__frame');
        const pop = host.querySelector<HTMLAnchorElement>('.composer-embed__pop');
        if (!frame) return;

        host.querySelectorAll<HTMLButtonElement>('.composer-embed__chip').forEach(chip => {
            chip.addEventListener('click', () => {
                const url = `https://shinyorg.github.io/controls/themes?preset=${chip.dataset.preset}`;
                frame.src = url;
                if (pop) pop.href = url;

                host.querySelectorAll('.composer-embed__chip').forEach(c => c.removeAttribute('aria-current'));
                chip.setAttribute('aria-current', 'true');
            });
        });
    });
</script>

<style>
    .composer-embed {
        margin: 1.5rem 0;
    }

    .composer-embed__bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.6rem;
    }

    .composer-embed__presets {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .composer-embed__chip {
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 999px;
        background: transparent;
        color: var(--sl-color-white);
        font-size: 0.8rem;
        cursor: pointer;
        transition: background-color 120ms ease, border-color 120ms ease;
    }

    .composer-embed__chip:hover {
        border-color: var(--sl-color-accent);
    }

    .composer-embed__chip[aria-current='true'] {
        background: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        color: var(--sl-color-black);
    }

    .composer-embed__pop {
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .composer-embed__frame {
        display: block;
        width: 100%;
        min-height: 420px;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.5rem;
        background: var(--sl-color-gray-7, #fff);
    }

    .composer-embed__note {
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: var(--sl-color-gray-3);
    }

    @media (max-width: 50rem) {
        .composer-embed__frame {
            height: 560px !important;
        }
    }
</style>
