---
/**
 * Homepage hero — "live editor" composition.
 *
 * The right-hand art is the thing a developer actually meets: a code window that cycles through
 * real Shiny snippets (verified against the library docs), each line "typed" in with a clip
 * reveal, followed by a small toast of what that code just did. It sits on an aurora wash and a
 * masked dot grid, with a few library chips drifting around it.
 *
 * Motion is CSS-driven so nothing needs a timer:
 *   .editor-tab.is-active .tab-progress  → fills over --cycle, and its animationend advances the tab
 *   .pane.is-active .ln                  → per-line clip reveal, staggered by --i
 *   .pane.is-active .toast               → pops in after the last line lands
 * Hovering or focusing the editor pauses the cycle; reduced motion turns the autoplay off
 * entirely (no animation, so no animationend) while the tabs keep working.
 */

import { platforms } from '../data/platforms';

const facts = [
  { value: 40,  suffix: 'M+', label: 'NuGet downloads' },
  { value: 50,  suffix: '+',  label: 'libraries' },
  { value: 85,  suffix: '+',  label: 'UI controls' },
  { value: null, text: 'AOT', label: 'trim-clean' },
  // Library repos counted 2026-11-25: 8,290 commits, ~1.52M non-blank lines. The token figure is an
  // estimate: ~24K tokens per committed line (measured from Claude Code usage, Nov 2026) applied to
  // the ~2M lines added in 2025-26, rounded down.
  { value: 1.5, decimals: 1, suffix: 'M+', label: 'lines of code' },
  { value: 8,   suffix: 'K+', label: 'commits' },
  { value: 30,  suffix: 'B+', label: 'AI tokens' },
];

