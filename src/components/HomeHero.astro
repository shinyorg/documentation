---
/**
 * Homepage hero — "scan" composition.
 *
 * The right-hand art is a radar field: rings ping outward from behind a fanned
 * deck of real MAUI screenshots. It's the literal thing the libraries do (BLE
 * scanning, network discovery, geofencing) rather than a decorative gradient.
 *
 * Motion is layered so the transforms don't fight each other:
 *   .phone      → static position + rotation
 *   .phone-in   → one-shot entrance
 *   .phone-bob  → continuous ambient float
 */

const phones = [
  { src: '/images/tableview/s1.png',   alt: 'TableView on iOS',   slot: -2 },
  { src: '/images/scheduler/s1.png',   alt: 'Scheduler on iOS',   slot: -1 },
  { src: '/images/chatview/s1.png',    alt: 'ChatView on iOS',    slot:  0 },
  { src: '/images/datagrid/s1.png',    alt: 'DataGrid on iOS',    slot:  1 },
  { src: '/images/imageeditor/s1.png', alt: 'ImageEditor on iOS', slot:  2 },
];

const facts = [
  { value: 40,  suffix: 'M+', label: 'NuGet downloads' },
  { value: 30,  suffix: '+',  label: 'libraries' },
  { value: 67,  suffix: '',   label: 'UI controls' },
  { value: null, text: 'AOT', label: 'trim-clean' },
];
---

<section class="hero not-content">
  <div class="hero-inner">
    <div class="hero-copy">
      <a class="brandline" href="/foundation/architecture/">
        <img src="/images/logo.svg" alt="" width="26" height="26" />
        <span>Shiny.NET</span>
      </a>

      <h1>The hard parts of your app,<br />already solved.</h1>

      <p class="lede">
        Bluetooth LE, background jobs, geofencing, push, an HTTP server that runs
        inside your MAUI app, a document database, 67 UI controls. Thirty-plus
        libraries that own the platform code, the permissions and the background
        execution &mdash; so your time goes to the app your users actually asked for.
      </p>

      <div class="hero-cta">
        <button class="btn btn-primary" data-open-finder type="button">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          Find a library
          <kbd>/</kbd>
        </button>
        <a class="btn" href="/foundation/appbuilder/">Start a project</a>
        <a class="btn btn-quiet btn-help" href="/foundation/support/">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M9.4 9.2a2.7 2.7 0 0 1 5.2.9c0 1.8-2.6 2.7-2.6 2.7"/><line x1="12" y1="17" x2="12" y2="17.01"/></svg>
          Get Help
        </a>
        <a class="btn btn-quiet" href="https://sponsor.shinylib.net" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.9-9.6-9A5.4 5.4 0 0 1 12 6.1 5.4 5.4 0 0 1 21.6 12c-2.1 4.1-9.6 9-9.6 9Z"/></svg>
          Sponsor
        </a>
      </div>

      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt data-count={f.value ?? undefined} data-suffix={f.suffix ?? ''}>
              {f.value === null ? f.text : `${f.value}${f.suffix}`}
            </dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-scan" aria-hidden="true">
      <div class="scan-field">
        <span class="ring" style="--r:0"></span>
        <span class="ring" style="--r:1"></span>
        <span class="ring" style="--r:2"></span>
        <span class="ring" style="--r:3"></span>
        <span class="sweep"></span>
      </div>

      <div class="fan">
        {phones.map((p, i) => (
          <div class="phone" style={`--slot:${p.slot}; --order:${Math.abs(p.slot)}; --seed:${i}`}>
            <div class="phone-in">
              <div class="phone-bob">
                <img src={p.src} alt={p.alt} width="420" height="912" loading="eager" decoding="async" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* ─────────────────────────────────────────────────────────────
     Layout
     ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    margin: 0 0 1rem;
    padding: 0;
    /* Bleed right only: the radar runs toward the viewport edge while the
       copy keeps the same left spine as every section below it. */
    --bleed: clamp(0rem, calc((100vw - var(--sl-content-width, 65rem)) / 2 - 1rem), 7rem);
    margin-right: calc(var(--bleed) * -1);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }

  /* ─────────────────────────────────────────────────────────────
     Copy column
     ───────────────────────────────────────────────────────────── */
  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-copy > * {
    /* Entrance: one orchestrated sequence down the column. */
    animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .hero-copy > :nth-child(1) { animation-delay: 0.05s; }
  .hero-copy > :nth-child(2) { animation-delay: 0.13s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.21s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.29s; }
  .hero-copy > :nth-child(5) { animation-delay: 0.37s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  .brandline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.1rem;
    padding: 0.3rem 0.85rem 0.3rem 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .brandline:hover {
    border-color: var(--shiny-purple-vivid);
    transform: translateY(-1px);
  }

  .brandline img {
    /* The logo is the one place the mark spins — a slow, barely-there idle. */
    animation: spin 34s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .brandline span {
    background: linear-gradient(105deg,
      var(--shiny-purple-vivid) 0%,
      var(--shiny-green-vivid) 55%,
      var(--shiny-lime-vivid) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.05rem, 4vw, 3.1rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.038em;
    text-wrap: balance;
    color: var(--sl-color-white);
  }

  .hero h1::after { display: none !important; }

  .lede {
    margin: 0 0 1.6rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  :global(:root[data-theme='dark']) .lede { color: var(--sl-color-gray-3); }

  /* ── Buttons ─────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.62rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: var(--shiny-purple-vivid);
    box-shadow: 0 8px 20px rgba(106, 61, 240, 0.18);
  }

  .btn-primary {
    position: relative;
    border-color: transparent;
    color: #fff;
    background: linear-gradient(112deg, #6A3DF0, #0FBF7A 78%, #A6D900);
    background-size: 200% 100%;
    box-shadow: 0 4px 16px rgba(106, 61, 240, 0.35);
    /* Slow gradient drift keeps the primary action alive without blinking. */
    animation: drift 9s ease-in-out infinite;
  }

  @keyframes drift {
    0%, 100% { background-position: 0% 50%; }
    50%      { background-position: 100% 50%; }
  }

  .btn-primary:hover {
    border-color: transparent;
    box-shadow: 0 10px 26px rgba(106, 61, 240, 0.5);
  }

  .btn-primary kbd {
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: rgba(255, 255, 255, 0.22);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .btn-quiet { color: var(--sl-color-gray-2); }
  .btn-quiet svg { color: #E5484D; }
  .btn-quiet:hover { border-color: #E5484D; box-shadow: 0 8px 20px rgba(229, 72, 77, 0.2); }

  /* Same quiet weight as Sponsor, but it's a docs destination, not the ask. */
  .btn-help svg { color: var(--shiny-green-vivid); }
  .btn-help:hover {
    border-color: var(--shiny-green-vivid);
    box-shadow: 0 8px 20px rgba(15, 191, 122, 0.2);
  }

  /* ── Facts ───────────────────────────────────────────────── */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1.1rem, 2.4vw, 2rem);
    margin: 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .fact { display: flex; flex-direction: column; }

  .fact dt {
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--shiny-purple-vivid), var(--shiny-green-vivid));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .fact dd {
    margin: 0.1rem 0 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  /* ─────────────────────────────────────────────────────────────
     Scan field + phone fan
     ───────────────────────────────────────────────────────────── */
  .hero-scan {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(340px, 42vw, 520px);
    /* Unitless scale for the whole composition; stepped at the breakpoints
       below, since clamp() can't mix a bare number with a vw term. */
    --fan: 1;
  }

  /* The rings and the sweep are sized off this box but paint (and, once the
     sweep starts rotating, *measure*) wider than it. Left unclipped that
     widens the document on a phone, which drags the fixed header's controls
     off-screen with it — so clip the decoration to the composition. */
  .scan-field {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: clip;
    pointer-events: none;
  }

  .ring {
    position: absolute;
    width: min(100%, 620px);
    aspect-ratio: 1;
    border: 1.5px solid var(--shiny-purple-vivid);
    border-radius: 50%;
    opacity: 0;
    animation: ping 5.6s cubic-bezier(0.16, 0.6, 0.3, 1) infinite;
    animation-delay: calc(var(--r) * 1.4s);
  }

  .ring:nth-child(even) { border-color: var(--shiny-green-vivid); }

  @keyframes ping {
    0%   { transform: scale(0.28); opacity: 0; }
    12%  { opacity: 0.85; }
    100% { transform: scale(1.3); opacity: 0; }
  }

  .sweep {
    position: absolute;
    width: min(100%, 620px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgba(106, 61, 240, 0.34) 0deg,
      rgba(106, 61, 240, 0.08) 34deg,
      transparent 74deg,
      transparent 360deg);
    mask-image: radial-gradient(circle, transparent 8%, #000 46%, transparent 88%);
    -webkit-mask-image: radial-gradient(circle, transparent 8%, #000 46%, transparent 88%);
    animation: spin 11s linear infinite;
  }

  :global(:root[data-theme='dark']) .sweep {
    background: conic-gradient(
      from 0deg,
      rgba(155, 123, 255, 0.46) 0deg,
      rgba(43, 229, 160, 0.14) 34deg,
      transparent 74deg,
      transparent 360deg);
  }

  /* ── The fan ─────────────────────────────────────────────── */
  .fan {
    position: relative;
    z-index: 1;
    /* Sits right of centre so the widest phone clears the headline. */
    transform: translateX(5%);
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  .phone {
    position: absolute;
    /* Slot drives every positional value, so the fan stays symmetrical. */
    width: calc((190px - var(--order) * 16px) * var(--fan));
    transform:
      translateX(calc(var(--slot) * 116px * var(--fan)))
      translateY(calc(var(--order) * 26px * var(--fan)))
      rotate(calc(var(--slot) * 7deg));
    z-index: calc(4 - var(--order));
    opacity: calc(1 - var(--order) * 0.1);
  }

  .phone-in {
    /* Entrance ripples outward from the centre phone — the scan finding
       devices one ring at a time. */
    animation: found 0.85s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc(0.35s + var(--order) * 0.16s);
  }

  @keyframes found {
    from { opacity: 0; transform: translateY(34px) scale(0.86); }
    to   { opacity: 1; transform: none; }
  }

  .phone-bob {
    animation: bob calc(6s + var(--seed) * 0.9s) ease-in-out infinite;
    animation-delay: calc(var(--seed) * -1.3s);
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-11px); }
  }

  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(18px * var(--fan));
    border: 1px solid var(--sl-color-gray-5);
    box-shadow:
      0 2px 6px rgba(12, 10, 26, 0.10),
      0 22px 48px rgba(12, 10, 26, 0.22);
  }

  :global(:root[data-theme='dark']) .phone img {
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      0 2px 6px rgba(0, 0, 0, 0.5),
      0 24px 56px rgba(0, 0, 0, 0.6);
  }

  /* ─────────────────────────────────────────────────────────────
     Responsive
     ───────────────────────────────────────────────────────────── */
  @media (max-width: 82rem) { .hero-scan { --fan: 0.86; } }
  @media (max-width: 72rem) { .hero-scan { --fan: 0.74; } }

  @media (max-width: 60rem) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-scan { order: -1; min-height: 320px; --fan: 0.72; }
    .fan { transform: none; }
  }

  @media (max-width: 46rem) { .hero-scan { min-height: 280px; --fan: 0.58; } }

  @media (max-width: 32rem) {
    .hero-scan { min-height: 230px; --fan: 0.44; }
    .facts { gap: 0.9rem 1.2rem; }
    .fact dt { font-size: 1.2rem; }
  }

  /* ─────────────────────────────────────────────────────────────
     Reduced motion — hold every animation on its end state.
     ───────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .brandline img,
    .btn-primary,
    .phone-in,
    .phone-bob,
    .sweep {
      animation: none !important;
    }
    .ring { animation: none !important; opacity: 0.18; transform: scale(calc(0.45 + var(--r) * 0.26)); }
  }
</style>

<script>
  // Count the facts up once, when the hero is actually on screen.
  (function () {
    const targets = document.querySelectorAll<HTMLElement>('.fact dt[data-count]');
    if (!targets.length) return;

    function settle(el: HTMLElement) {
      el.textContent = el.dataset.count + (el.dataset.suffix || '');
    }

    // The markup already holds the real numbers, so anything that stops the
    // animation from running simply leaves them alone.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (document.hidden) return;

    targets.forEach((el) => {
      el.textContent = '0' + (el.dataset.suffix || '');
    });

    // Counting mid-flight in a hidden tab is worse than not animating: rAF is
    // paused there, so the number freezes on a wrong value and stays wrong.
    // Track what's still running and snap it whenever the tab goes away.
    const running = new Set<HTMLElement>();

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) return;
      running.forEach(settle);
      running.clear();
    });

    function run(el: HTMLElement) {
      if (document.hidden) return settle(el);

      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix || '';
      const duration = 1100;
      const start = performance.now();
      running.add(el);

      function frame(now: number) {
        if (!running.has(el)) return;   // settled early by the tab going hidden
        const t = Math.min(1, (now - start) / duration);
        // easeOutExpo — fast off the line, glides into the real number.
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        el.textContent = Math.round(target * eased) + suffix;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          running.delete(el);
        }
      }
      requestAnimationFrame(frame);
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        run(entry.target as HTMLElement);
        io.unobserve(entry.target);
      });
    }, { threshold: 0.6 });

    targets.forEach((el) => io.observe(el));
  })();
</script>
