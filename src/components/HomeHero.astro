// A tiny C# highlighter — enough for these snippets, and it keeps the markup static.
const KEYWORDS = new Set([
  'var', 'new', 'await', 'async', 'public', 'private', 'class', 'record', 'readonly', 'using',
  'return', 'this', 'string', 'int', 'bool', 'void', 'static', 'override', 'partial', 'foreach',
  'if', 'is', 'in', 'interface',
]);

type Token = { t: string; c?: string };

function tokenize(line: string): Token[] {
  const out: Token[] = [];
  const re = /(\/\/.*$)|(\$?"(?:[^"\\]|\\.)*")|(\[[A-Z]\w*\])|(\b\d+\b)|([A-Za-z_]\w*)|(\s+|.)/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(line))) {
    const [all, comment, str, attr, num, ident] = m;
    const next = line[re.lastIndex] ?? '';
    let c: string | undefined;
    if (comment) c = 'cm';
    else if (str) c = 'st';
    else if (attr) c = 'at';
    else if (num) c = 'nu';
    else if (ident) {
      if (KEYWORDS.has(ident)) c = 'kw';
      else if (next === '(' ) c = 'fn';
      else if (/^[A-Z]/.test(ident)) c = 'ty';
    }
    out.push({ t: all, c });
  }
  return out;
}

const panes = snippets.map((s) => ({ ...s, lines: s.code.split('\n').map(tokenize) }));
const maxLines = Math.max(...panes.map((p) => p.lines.length));

const chips = [
  { label: 'Push',        x: '-4%',  y: '2%',  d: 0 },
  { label: 'GPS',         x: '88%',  y: '2%',  d: 1 },
  { label: 'Speech',      x: '93%',  y: '40%', d: 2 },
  { label: 'DocumentDb',  x: '4%',   y: '93%', d: 3 },
  { label: 'AI tools',    x: '62%',  y: '94%', d: 4 },
];
---

<section class="hero not-content">
  <div class="hero-inner">
    <div class="hero-copy">
      <a class="brand-lockup" href="/foundation/architecture/" aria-label="Shiny Platform">
        <img class="on-dark" src="/brand/shiny-platform-dark.svg" alt="Shiny Platform" width="1215" height="388" />
        <img class="on-light" src="/brand/shiny-platform-light.svg" alt="Shiny Platform" width="1215" height="388" />
      </a>

      <h1 data-reveal="split" data-reveal-delay="120">Everything you need on .NET.<br /><span class="hl">One platform.</span></h1>

      <p class="lede">
        The Shiny Platform covers .NET app development end to end. Native UI for MAUI and
        Blazor. Data everywhere: a document database across 18 providers, from SQLite and
        IndexedDB on the device to Cosmos, Mongo and Postgres in the cloud, plus EF Core
        extensions for spatial, vector and full-text search, outbox and seeding. Push,
        Bluetooth and Wi-Fi hubs, background transfers, device hardware and AI. And .NET
        Aspire integrations for Orleans, databases, VPNs and tunnels. Fifty-plus libraries,
        one way of working &mdash; so your time goes to the app your users actually asked for.
      </p>

      <div class="platforms">
        <span class="platforms-label">Runs everywhere .NET does</span>
        <ul>
          {platforms.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
                <path d={p.path} />
              </svg>
              {p.label}
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-cta">
        <button class="btn btn-primary" data-open-finder type="button">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          Find a library
          <kbd>/</kbd>
        </button>
        <a class="btn" href="/foundation/appbuilder/">Start a project</a>
        <a class="btn btn-quiet btn-help" href="/foundation/support/">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M9.4 9.2a2.7 2.7 0 0 1 5.2.9c0 1.8-2.6 2.7-2.6 2.7"/><line x1="12" y1="17" x2="12" y2="17.01"/></svg>
          Get Help
        </a>
        <a class="btn btn-quiet" href="https://sponsor.shinylib.net" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.9-9.6-9A5.4 5.4 0 0 1 12 6.1 5.4 5.4 0 0 1 21.6 12c-2.1 4.1-9.6 9-9.6 9Z"/></svg>
          Sponsor
        </a>
        <a class="btn btn-quiet btn-merch" href="https://www.redbubble.com/shop/ap/173996199" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.4 3.5 16 2a4 4 0 0 1-8 0L3.6 3.5a2 2 0 0 0-1.3 2.2l.6 3.5a1 1 0 0 0 1 .8H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.1a1 1 0 0 0 1-.8l.6-3.5a2 2 0 0 0-1.3-2.2Z"/></svg>
          Merch
        </a>
      </div>

      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt data-count={f.value ?? undefined} data-suffix={f.suffix ?? ''} data-decimals={f.decimals ?? undefined}>
              {f.value === null ? f.text : `${f.value.toFixed(f.decimals ?? 0)}${f.suffix}`}
            </dt>
            <dd>{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-art">
      <div class="aurora" aria-hidden="true" data-parallax="0.12" data-depth="-16">
        <span class="blob blob--purple"></span>
        <span class="blob blob--green"></span>
        <span class="blob blob--lime"></span>
      </div>
      <div class="dot-grid" aria-hidden="true" data-parallax="0.06"></div>

      <div class="chips" aria-hidden="true" data-depth="14">
        {chips.map((c) => (
          <span class="chip" style={`--x:${c.x}; --y:${c.y}; --d:${c.d}`}>
            <span class="chip-dot"></span>{c.label}
          </span>
        ))}
      </div>

      <div class="editor-wrap" data-depth="-8" style={`--lines:${maxLines}`}>
        <div class="editor" data-editor>
          <div class="editor-bar">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <div class="editor-tabs" role="tablist" aria-label="Shiny code samples">
              {panes.map((p, i) => (
                <button
                  class:list={['editor-tab', { 'is-active': i === 0 }]}
                  role="tab"
                  type="button"
                  id={`hero-tab-${p.id}`}
                  aria-controls={`hero-pane-${p.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-pkg={p.pkg}
                >
                  <span class="tab-label">{p.label}</span>
                  <span class="tab-progress" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </div>

          <div class="editor-body">
            {panes.map((p, i) => (
              <div
                class:list={['pane', { 'is-active': i === 0 }]}
                role="tabpanel"
                id={`hero-pane-${p.id}`}
                aria-labelledby={`hero-tab-${p.id}`}
                hidden={i !== 0}
              >
                <div class="pane-file">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                  {p.file}
                  <a class="pane-docs" href={p.href} tabindex={i === 0 ? 0 : -1}>Docs →</a>
                </div>
                <pre class="code"><code>{p.lines.map((tokens, li) => (
                  <span class="ln" style={`--i:${li}`}><span class="gutter" aria-hidden="true">{li + 1}</span>{tokens.length ? tokens.map((tk) => tk.c ? <span class={`tk-${tk.c}`}>{tk.t}</span> : tk.t) : ' '}{li === p.lines.length - 1 && <span class="caret" aria-hidden="true"></span>}</span>
                ))}</code></pre>
                <div class:list={['toast', `toast--${p.toast.tone}`]} style={`--n:${p.lines.length}`} aria-hidden="true">
                  <span class="toast-icon">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.2 4.2L19 7"/></svg>
                  </span>
                  <span class="toast-text"><strong>{p.toast.title}</strong><span class="toast-detail">{p.toast.detail}</span><span class="toast-note">{p.toast.note}</span></span>
                </div>
              </div>
            ))}
          </div>

          <div class="editor-term">
            <span class="term-prompt" aria-hidden="true">$</span>
            <span class="term-cmd">dotnet add package <span class="term-pkg" data-term-pkg>{panes[0].pkg}</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─────────────────────────────────────────────────────────────
     Layout
     ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    margin: 0 0 1rem;
    padding: 0;
    /* Bleed right only: the radar runs toward the viewport edge while the
       copy keeps the same left spine as every section below it. */
    --bleed: clamp(0rem, calc((100vw - var(--sl-content-width, 65rem)) / 2 - 1rem), 7rem);
    margin-right: calc(var(--bleed) * -1);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
  }

  /* ─────────────────────────────────────────────────────────────
     Copy column
     ───────────────────────────────────────────────────────────── */
  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-copy > * {
    /* Entrance: one orchestrated sequence down the column. */
    animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }
  .hero-copy > :nth-child(1) { animation-delay: 0.05s; }
  .hero-copy > :nth-child(2) { animation-delay: 0.13s; }
  .hero-copy > :nth-child(3) { animation-delay: 0.21s; }
  .hero-copy > :nth-child(4) { animation-delay: 0.29s; }
  .hero-copy > :nth-child(5) { animation-delay: 0.37s; }

  /* With the motion system running, the headline rises word by word instead (data-reveal="split"
     in HomeMotion). Without it — no JS, reduced motion — it keeps the rise above. */
  :global(html.motion) .hero h1 { animation: none; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  .brand-lockup {
    display: inline-block;
    margin: 0 0 1.2rem -0.4rem;
    transition: transform 0.25s ease;
  }

  .brand-lockup img {
    display: block;
    height: clamp(4.5rem, 9vw, 6.25rem);
    width: auto;
    max-width: 100%;
  }

  .brand-lockup:hover { transform: translateY(-2px); }

  /* One file per theme. Starlight's light:/dark:sl-hidden live in a cascade layer, so the
     display rule above would beat them; switch here instead. */
  :global(:root[data-theme='light']) .brand-lockup .on-dark,
  :global(:root[data-theme='dark']) .brand-lockup .on-light { display: none; }

  .hero h1 {
    margin: 0 0 1rem;
    font-family: var(--shiny-font-display);
    font-size: clamp(2.4rem, 4.6vw, 3.9rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.048em;
    text-wrap: balance;
    color: var(--shiny-text-strong);
  }

  .hero h1::after { display: none !important; }

  .lede {
    margin: 0 0 1.6rem;
    max-width: 34rem;
    font-size: clamp(1rem, 1.15vw, 1.1rem);
    line-height: 1.65;
    color: var(--shiny-text-muted);
  }

  /* ── Platform rail ───────────────────────────────────────── */
  /* The reach claim, stated as marks rather than a sentence: one row from
     the servers Shiny runs on to the screens it renders on. */
  .platforms {
    /* Wider than the lede's 34rem measure so the six marks stay on one line. */
    margin: 0 0 1.5rem;
    max-width: 40rem;
  }

  .platforms-label {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .platforms ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .platforms li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem 0.32rem 0.6rem;
    border: 1px solid var(--shiny-hairline-strong);
    border-radius: 999px;
    background: var(--shiny-surface-2);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--shiny-text);
    white-space: nowrap;
  }

  .platforms li svg {
    flex: none;
    color: var(--shiny-text-faint);
  }

  /* ── Buttons ─────────────────────────────────────────────── */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.68rem 1.2rem;
    border: 1px solid var(--shiny-hairline-strong);
    border-radius: 0.75rem;
    background: var(--shiny-surface);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--shiny-text-strong);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.25s var(--shiny-ease), border-color 0.18s ease, box-shadow 0.25s ease, background-color 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: rgb(var(--shiny-violet-rgb) / 0.55);
    box-shadow: var(--shiny-shadow-lift);
  }

  .btn-primary {
    position: relative;
    border-color: transparent;
    color: var(--shiny-cta-fg);
    background: var(--shiny-cta-bg);
    box-shadow: var(--shiny-cta-shadow);
  }

  .btn-primary:hover {
    border-color: transparent;
    background: var(--shiny-cta-bg-hover);
    box-shadow: var(--shiny-cta-shadow);
  }

  .btn-primary kbd {
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    background: color-mix(in srgb, currentColor 14%, transparent);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .btn-quiet { color: var(--sl-color-gray-2); }
  .btn-quiet svg { color: #E5484D; }
  .btn-quiet:hover { border-color: #E5484D; box-shadow: 0 8px 20px rgba(229, 72, 77, 0.2); }

  /* Same quiet weight as Sponsor, but it's a docs destination, not the ask. */
  .btn-help svg { color: var(--shiny-green-vivid); }
  .btn-help:hover {
    border-color: var(--shiny-green-vivid);
    box-shadow: 0 8px 20px rgb(var(--shiny-mint-rgb) / 0.2);
  }

  /* Merch: the store, not the ask — its own hue so it doesn't read as a second Sponsor. */
  .btn-merch svg { color: var(--topic-7); }
  .btn-merch:hover { border-color: var(--topic-7); }

  /* ── Facts ───────────────────────────────────────────────── */
  /* Four columns: the original facts on top, the scale numbers (lines, commits, tokens) below. */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 0.9rem clamp(1.1rem, 2.4vw, 2rem);
    margin: 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--shiny-hairline);
  }

  .fact { display: flex; flex-direction: column; }

  .fact dt {
    font-family: var(--shiny-font-display);
    font-size: 1.6rem;
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    background: var(--shiny-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .fact dd {
    margin: 0.1rem 0 0;
    font-size: 0.8rem;
    color: var(--shiny-text-faint);
  }

  /* ─────────────────────────────────────────────────────────────
     Art column — aurora, dot grid, chips and the live editor
     ───────────────────────────────────────────────────────────── */
  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(380px, 40vw, 520px);
    grid-template-columns: minmax(0, 1fr);
    padding: 1.5rem 0;
    --cycle: 7s;
  }

  /* Aurora + grid paint wider than the column; clip so a phone never scrolls sideways. */
  .aurora,
  .dot-grid {
    position: absolute;
    inset: -6% -4%;
    pointer-events: none;
  }

  .aurora { overflow: clip; filter: blur(46px) saturate(1.15); opacity: 0.55; }
  :global(:root[data-theme='dark']) .aurora { opacity: 0.75; }

  .blob {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: normal;
  }

  .blob--purple {
    width: 58%; aspect-ratio: 1; left: 12%; top: 6%;
    background: radial-gradient(circle, var(--shiny-purple-vivid), transparent 68%);
    animation: drift-a 16s ease-in-out infinite;
  }
  .blob--green {
    width: 50%; aspect-ratio: 1; right: 4%; top: 30%;
    background: radial-gradient(circle, var(--shiny-green-vivid), transparent 68%);
    animation: drift-b 19s ease-in-out infinite;
  }
  .blob--lime {
    width: 36%; aspect-ratio: 1; left: 26%; bottom: 0;
    background: radial-gradient(circle, var(--shiny-lime-vivid), transparent 70%);
    opacity: 0.7;
    animation: drift-c 22s ease-in-out infinite;
  }

  @keyframes drift-a { 50% { transform: translate(14%, 10%) scale(1.08); } }
  @keyframes drift-b { 50% { transform: translate(-16%, -8%) scale(0.92); } }
  @keyframes drift-c { 50% { transform: translate(18%, -14%) scale(1.15); } }

  .dot-grid {
    background-image: radial-gradient(circle, color-mix(in srgb, var(--sl-color-gray-3) 55%, transparent) 1px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 50%, #000 30%, transparent 75%);
    opacity: 0.5;
  }

  /* ── Chips ───────────────────────────────────────────────── */
  .chips { position: absolute; inset: 0; pointer-events: none; z-index: 3; }

  .chip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem 0.3rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 50%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-bg) 72%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(12, 10, 26, 0.12);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sl-color-gray-1);
    white-space: nowrap;
    animation:
      chip-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards,
      float calc(6s + var(--d) * 0.8s) ease-in-out infinite;
    animation-delay: calc(0.9s + var(--d) * 0.12s), calc(var(--d) * -1.1s);
  }

  .chip-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--shiny-green-vivid);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--shiny-green-vivid) 22%, transparent);
  }
  .chip:nth-child(even) .chip-dot {
    background: var(--shiny-purple-vivid);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--shiny-purple-vivid) 22%, transparent);
  }
  .chip:nth-child(5) .chip-dot {
    background: var(--shiny-lime-vivid);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--shiny-lime-vivid) 25%, transparent);
  }

  @keyframes chip-in { from { opacity: 0; transform: translateY(10px) scale(0.9); } }
  @keyframes float { 50% { translate: 0 -9px; } }

  /* ── Editor ──────────────────────────────────────────────── */
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .editor-wrap {
    position: relative;
    justify-self: center;
    z-index: 2;
    width: min(100%, 35rem);
    padding: 1px;
    border-radius: 18px;
    /* A slowly orbiting gradient hairline around the window. */
    background: conic-gradient(from var(--angle),
      rgba(255, 255, 255, 0.08) 0deg,
      var(--shiny-purple-vivid) 70deg,
      rgba(255, 255, 255, 0.08) 140deg,
      var(--shiny-green-vivid) 230deg,
      rgba(255, 255, 255, 0.08) 300deg);
    box-shadow:
      0 2px 6px rgba(12, 10, 26, 0.12),
      0 40px 90px -20px rgba(40, 20, 110, 0.55),
      0 0 120px -30px rgb(var(--shiny-violet-rgb) / 0.45);
    animation:
      editor-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.25s backwards,
      orbit 10s linear infinite;
  }

  @keyframes editor-in { from { opacity: 0; transform: translateY(26px) scale(0.97); } }
  @keyframes orbit { to { --angle: 360deg; } }

  /* The editor is dark in both themes — a code window, not a page surface. */
  .editor {
    /* Pin the brand to its on-ink values: in light mode the page tokens are the deep variants. */
    --shiny-violet: #AE99FF;
    --shiny-mint: #91F5AD;
    --shiny-lime-ink: #CFFA12;
    --shiny-violet-rgb: 174 153 255;
    --shiny-mint-rgb: 145 245 173;
    --shiny-purple-vivid: #AE99FF;
    --shiny-green-vivid: #91F5AD;
    --shiny-lime-vivid: #CFFA12;
    --ed-bg: #110F1C;
    --ed-bar: #0C0B15;
    --ed-line: rgba(255, 255, 255, 0.07);
    --ed-text: #e6e3f2;
    --ed-dim: #7c7896;
    position: relative;
    overflow: hidden;
    border-radius: 17px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(var(--shiny-violet-rgb) / 0.16), transparent 55%),
      radial-gradient(90% 70% at 0% 100%, rgb(var(--shiny-mint-rgb) / 0.10), transparent 60%),
      var(--ed-bg);
    color: var(--ed-text);
  }

  .editor-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0 0.9rem;
    background: color-mix(in srgb, var(--ed-bar) 85%, transparent);
    border-bottom: 1px solid var(--ed-line);
  }

  .lights { display: inline-flex; gap: 6px; flex: none; }
  .lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
  .lights i:nth-child(2) { background: #febc2e; }
  .lights i:nth-child(3) { background: #28c840; }

  .editor-tabs {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    /* More tabs than fit: fade the edges so the strip reads as scrollable. */
    mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 28px), transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 28px), transparent);
  }
  .editor-tabs::-webkit-scrollbar { display: none; }

  .editor-tab {
    position: relative;
    flex: none;
    padding: 0.8rem 0.75rem 0.75rem;
    border: 0;
    background: none;
    color: var(--ed-dim);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .editor-tab:hover { color: var(--ed-text); }
  .editor-tab.is-active { color: #fff; }
  .editor-tab:focus-visible { outline: 2px solid var(--shiny-green-vivid); outline-offset: -4px; border-radius: 6px; }

  .tab-progress {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--shiny-violet), var(--shiny-mint), #C4F03A);
    transform: scaleX(0);
    transform-origin: left;
  }

  .editor-tab.is-active .tab-progress {
    transform: scaleX(1);
  }

  /* With autoplay on, the active tab's bar fills over one cycle; its end advances the tab. */
  .editor.is-playing .editor-tab.is-active .tab-progress {
    animation: fill var(--cycle) linear both;
  }

  .editor.is-playing:hover .tab-progress,
  .editor.is-playing:focus-within .tab-progress { animation-play-state: paused; }

  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .editor-body {
    position: relative;
    /* Hold the height of the longest snippet so the hero never jumps between tabs. */
    min-height: calc(var(--lines) * 1.7em + 8.4rem);
    font-size: 0.78rem;
  }

  .pane { position: relative; }
  .pane[hidden] { display: none; }

  .pane-file {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem 0.2rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ed-dim);
  }

  .pane-docs {
    margin-left: auto;
    color: var(--shiny-mint);
    font-weight: 700;
    text-decoration: none;
    opacity: 0.85;
  }
  .pane-docs:hover { opacity: 1; text-decoration: underline; }

  .code {
    margin: 0;
    padding: 0.4rem 1rem 1.1rem 0;
    overflow-x: auto;
    background: none;
    border: 0;
    font-family: var(--__sl-font-mono, ui-monospace, 'SF Mono', Menlo, Consolas, monospace);
    font-size: 1em;
    line-height: 1.7;
    color: var(--ed-text);
    scrollbar-width: none;
  }
  .code::-webkit-scrollbar { display: none; }

  .code code { background: none; padding: 0; font: inherit; color: inherit; }

  .ln {
    display: block;
    white-space: pre;
  }

  .gutter {
    display: inline-block;
    width: 2.6rem;
    padding-right: 1rem;
    text-align: right;
    color: #4d4a63;
    user-select: none;
  }

  /* Typing: each line wipes in from the left, one after another. */
  .editor.is-animating .pane.is-active .ln {
    animation: type 0.42s steps(18, end) backwards;
    animation-delay: calc(0.08s + var(--i) * 0.11s);
  }

  @keyframes type {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: -0.2em;
    border-radius: 1px;
    background: var(--shiny-mint);
    animation: blink 1.05s steps(1) infinite;
  }

  @keyframes blink { 50% { opacity: 0; } }

  /* Catppuccin Mocha — the same syntax palette as every code block on the site */
  .tk-kw { color: #cba6f7; }
  .tk-ty { color: #94e2d5; }
  .tk-fn { color: #89b4fa; }
  .tk-st { color: #a6e3a1; }
  .tk-nu { color: #fab387; }
  .tk-at { color: #f9e2af; }
  .tk-cm { color: #6c7086; font-style: italic; }

  /* ── Toast ───────────────────────────────────────────────── */
  /* The toast is the snippet's "output": its own row under the code, so it never covers a line. */
  .toast {
    width: fit-content;
    margin: -0.3rem 0.9rem 0.9rem auto;
    --tone: var(--shiny-mint);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    max-width: min(20rem, calc(100% - 1.8rem));
    padding: 0.6rem 0.9rem 0.6rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 2px solid var(--tone);
    border-radius: 12px;
    background: rgba(32, 28, 50, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    font-family: var(--sl-font, inherit);
    font-size: 0.74rem;
    line-height: 1.3;
  }

  .editor.is-animating .pane.is-active .toast {
    animation: toast-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    animation-delay: calc(0.35s + var(--n) * 0.11s);
  }

  @keyframes toast-in { from { opacity: 0; transform: translateY(12px) scale(0.92); } }

  .toast--purple { --tone: var(--shiny-violet); }
  .toast--lime { --tone: #C4F03A; }

  /* A soft wash of the tone colour behind the text. */
  .toast::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--tone) 16%, transparent), transparent 60%);
    pointer-events: none;
  }

  .toast-icon {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 8px;
    color: #0c0a16;
    background: var(--tone);
  }

  /* One ring ripples out of the check as the toast lands. */
  .toast-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 var(--tone);
    opacity: 0;
  }
  .editor.is-animating .pane.is-active .toast-icon::after {
    animation: ping-ring 1.1s ease-out backwards;
    animation-delay: calc(0.65s + var(--n) * 0.11s);
  }
  @keyframes ping-ring {
    0%   { opacity: 0.7; box-shadow: 0 0 0 0 var(--tone); }
    100% { opacity: 0; box-shadow: 0 0 0 10px var(--tone); }
  }

  .toast-text { position: relative; display: flex; flex-direction: column; min-width: 0; }
  .toast-text strong { color: #fff; font-weight: 700; }
  .toast-detail { color: #a9a5c2; }
  .toast-note {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #8d89a8;
    font-size: 0.68rem;
    line-height: 1.35;
  }

  /* ── Terminal strip ──────────────────────────────────────── */
  .editor-term {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--ed-line);
    background: rgba(0, 0, 0, 0.22);
    font-family: var(--__sl-font-mono, ui-monospace, 'SF Mono', Menlo, Consolas, monospace);
    font-size: 0.74rem;
    color: #a9a5c2;
    white-space: nowrap;
    overflow: hidden;
  }

  .term-prompt { color: var(--shiny-mint); font-weight: 700; }
  .term-pkg { color: #fff; font-weight: 600; }
  .term-pkg.is-swapping { animation: swap 0.45s ease both; }

  @keyframes swap {
    from { opacity: 0; filter: blur(4px); transform: translateY(4px); }
    to   { opacity: 1; filter: none; transform: none; }
  }

  /* ─────────────────────────────────────────────────────────────
     Headline highlight
     ───────────────────────────────────────────────────────────── */
  .hl,
  .hl :global(.split-inner) {
    background: linear-gradient(100deg,
      var(--shiny-purple-vivid) 0%,
      var(--shiny-green-vivid) 60%,
      var(--shiny-lime-vivid) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: drift 10s ease-in-out infinite;
  }

  /* ─────────────────────────────────────────────────────────────
     Responsive
     ───────────────────────────────────────────────────────────── */
  /* Below this the column is too narrow for chips to float clear of the editor. */
  @media (max-width: 76rem) {
    .chips { display: none; }
  }

  @media (max-width: 60rem) {
    /* minmax(0, …): a plain 1fr would let the code's longest line widen the page. */
    .hero-inner { grid-template-columns: minmax(0, 1fr); }
    .hero-art { min-height: 0; padding: 2rem 0 0.5rem; overflow-x: clip; }
  }

  @media (max-width: 46rem) {
    .editor-body { font-size: 0.72rem; }
    .gutter { width: 2rem; padding-right: 0.7rem; }
  }

  @media (max-width: 32rem) {
    .facts { gap: 0.9rem 1.2rem; grid-template-columns: repeat(2, auto); }
    .fact dt { font-size: 1.2rem; }
  }

  /* ─────────────────────────────────────────────────────────────
     Reduced motion — hold every animation on its end state.
     ───────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .brand-lockup,
    .btn-primary,
    .blob,
    .chip,
    .editor-wrap,
    .caret,
    .hl,
    .hl :global(.split-inner),
    .term-pkg,
    .toast-icon::after {
      animation: none !important;
    }
  }
</style>

<script>
  // Live editor: tabs, autoplay (driven by the progress bar's animationend) and the package strip.
  (function () {
    const editor = document.querySelector<HTMLElement>('[data-editor]');
    if (!editor) return;

    const tabs = Array.from(editor.querySelectorAll<HTMLButtonElement>('.editor-tab'));
    const panes = Array.from(editor.querySelectorAll<HTMLElement>('.pane'));
    const pkg = editor.querySelector<HTMLElement>('[data-term-pkg]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    if (!reduced) {
      editor.classList.add('is-animating');
      // Start the cycle only once the hero is on screen, and stop it for good once the reader picks a tab.
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          editor.classList.toggle('is-playing', entry.isIntersecting && !editor.dataset.manual);
        });
      }, { threshold: 0.35 });
      io.observe(editor);
    }

    function show(index: number, focus = false) {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        const on = i === current;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        panes[i].classList.toggle('is-active', on);
        panes[i].hidden = !on;
        panes[i].querySelectorAll<HTMLElement>('a').forEach((a) => (a.tabIndex = on ? 0 : -1));
      });
      if (focus) tabs[current].focus({ preventScroll: true });
      // Keep the active tab centred in the strip without scrolling the page.
      const strip = tabs[current].parentElement;
      if (strip) {
        const t = tabs[current].getBoundingClientRect();
        const r = strip.getBoundingClientRect();
        strip.scrollBy({ left: t.left + t.width / 2 - (r.left + r.width / 2), behavior: reduced ? 'auto' : 'smooth' });
      }
      if (pkg) {
        pkg.textContent = tabs[current].dataset.pkg ?? '';
        pkg.classList.remove('is-swapping');
        void pkg.offsetWidth; // restart the swap animation
        if (!reduced) pkg.classList.add('is-swapping');
      }
    }

    function pick(index: number, focus = false) {
      editor!.dataset.manual = 'true';
      editor!.classList.remove('is-playing');
      show(index, focus);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => pick(i));
      tab.querySelector('.tab-progress')?.addEventListener('animationend', () => {
        if (editor.classList.contains('is-playing') && i === current) show(current + 1);
      });
    });

    editor.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      const moves: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1 };
      if (key in moves) {
        e.preventDefault();
        pick(current + moves[key], true);
      } else if (key === 'Home' || key === 'End') {
        e.preventDefault();
        pick(key === 'Home' ? 0 : tabs.length - 1, true);
      }
    });
  })();
</script>

<script>
  // Count the facts up once, when the hero is actually on screen.
  (function () {
    const targets = document.querySelectorAll<HTMLElement>('.fact dt[data-count]');
    if (!targets.length) return;

    const format = (el: HTMLElement, n: number) => n.toFixed(Number(el.dataset.decimals ?? 0));

    function settle(el: HTMLElement) {
      el.textContent = format(el, Number(el.dataset.count)) + (el.dataset.suffix || '');
    }

    // The markup already holds the real numbers, so anything that stops the
    // animation from running simply leaves them alone.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (document.hidden) return;

    targets.forEach((el) => {
      el.textContent = format(el, 0) + (el.dataset.suffix || '');
    });

    // Counting mid-flight in a hidden tab is worse than not animating: rAF is
    // paused there, so the number freezes on a wrong value and stays wrong.
    // Track what's still running and snap it whenever the tab goes away.
    const running = new Set<HTMLElement>();

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) return;
      running.forEach(settle);
      running.clear();
    });

    function run(el: HTMLElement) {
      if (document.hidden) return settle(el);

      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix || '';
      const duration = 1100;
      const start = performance.now();
      running.add(el);

      function frame(now: number) {
        if (!running.has(el)) return;   // settled early by the tab going hidden
        const t = Math.min(1, (now - start) / duration);
        // easeOutExpo — fast off the line, glides into the real number.
        const eased = t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        const d = Number(el.dataset.decimals ?? 0), p = 10 ** d;
        el.textContent = (Math.round(target * eased * p) / p).toFixed(d) + suffix;
        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          running.delete(el);
        }
      }
      requestAnimationFrame(frame);
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        run(entry.target as HTMLElement);
        io.unobserve(entry.target);
      });
    }, { threshold: 0.6 });

    targets.forEach((el) => io.observe(el));
  })();
</script>
