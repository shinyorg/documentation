---
// Homepage "Our Apps" cards: ShinySoft's own desktop apps, built on Shiny,
// each opening its product website. Data lives in `src/data/shinyApps.ts`.
import { Icon } from '@astrojs/starlight/components';
import { shinyApps } from '../data/shinyApps';
---

<div class="shiny-apps not-content" data-stagger="up" data-stagger-step="80">
  {shinyApps.map((app) => (
    <a class="shiny-app-card" data-spotlight href={app.website} target="_blank" rel="noopener noreferrer">
      <img class="shiny-app-logo" src={app.logo} alt="" width="72" height="72" loading="lazy" />
      <span class="shiny-app-name">{app.name}</span>
      <span class="shiny-app-tagline">{app.tagline}</span>
      <span class="shiny-app-desc">{app.description}</span>
      <span class="shiny-app-more">Visit website<Icon name="external" /></span>
    </a>
  ))}
</div>

<p class="shiny-apps-all not-content"><a href="/blog/2026/11/three-desktop-apps/">How they're built on Shiny<Icon name="right-arrow" /></a></p>

<style>
  .shiny-apps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .shiny-app-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 1.75rem 1.4rem 1.3rem;
    border-radius: 0.9rem;
    border: 1px solid var(--sl-color-gray-6);
    background: var(--sl-color-bg);
    color: inherit;
    text-align: center;
    text-decoration: none !important;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  :global(:root[data-theme='dark']) .shiny-app-card {
    border-color: var(--sl-color-gray-5);
    background: rgba(255, 255, 255, 0.03);
  }

  .shiny-app-card:hover {
    transform: translateY(-4px);
    border-color: var(--sl-color-accent);
    box-shadow: 0 12px 32px rgba(106, 61, 240, 0.35);
  }

  .shiny-app-logo {
    width: 72px;
    height: 72px;
    margin-bottom: 0.35rem;
    border-radius: 18px;
  }

  .shiny-app-name {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .shiny-app-tagline {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .shiny-app-desc {
    flex: 1;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }

  .shiny-app-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  .shiny-apps-all {
    margin-bottom: 3rem;
    text-align: center;
  }

  .shiny-apps-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }
</style>
