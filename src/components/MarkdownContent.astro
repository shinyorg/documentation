---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import BlogMarkdownContent from 'starlight-blog/components/MarkdownContent.astro';
import Giscus from './Giscus.astro';
import ReadingProgress from './ReadingProgress.astro';
import { getReadingTime } from '../utils/readingTime';

const entry = Astro.locals.starlightRoute?.entry;
const isBlogPost = entry?.id?.startsWith('blog/') ?? false;
const optedIn = entry?.data?.comments === true;
const showGiscus = isBlogPost || optedIn;

// Reading time is estimated from the raw markdown source, so it only exists for
// real content entries (the blog list/tag pages are virtual and have no body).
const readingMinutes = isBlogPost ? getReadingTime(entry?.body).minutes : 0;
---

{
  isBlogPost ? (
    <BlogMarkdownContent><slot /></BlogMarkdownContent>
  ) : (
    <Default><slot /></Default>
  )
}
{readingMinutes > 0 && <ReadingProgress minutes={readingMinutes} />}
{showGiscus && <Giscus />}
