---
export interface Props {
    name: string;
    showLabel?: boolean;
    showPreviewVersion?: boolean;
    // Render the package name as the badge message instead of the version - use when several
    // badges sit together and version-only badges would all look identical.
    showName?: boolean;
}

const { name, showPreviewVersion, showLabel, showName } = Astro.props as Props;

let imgUrl: string;
if (showName === true) {
    const escaped = name.replace(/-/g, '--').replace(/_/g, '__');
    imgUrl = `https://img.shields.io/badge/nuget-${escaped}-004880?style=for-the-badge&logo=nuget`;
}
else {
    const v = showPreviewVersion === true ? 'vpre' : 'v';
    imgUrl = `https://img.shields.io/nuget/${v}/${name}?style=for-the-badge&logo=nuget`;
    if (showLabel === true) {
        imgUrl += `&label=${name}`;
    }
}
const nugetUrl: string = `https://www.nuget.org/packages/${name}`;
---
<a href={nugetUrl} target="_blank" rel="noopener noreferrer"><img src={imgUrl} alt={`NuGet package ${name}`} /></a>
