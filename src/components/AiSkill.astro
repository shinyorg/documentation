---
export interface Props {
    /** Optional skill name (e.g. "shiny-bluetoothle") — adds a direct link to that SKILL.md. */
    skillName?: string;
    /** Aliases accepted for convenience — some pages use these. */
    skill?: string;
    name?: string;
    repoUrl?: string;
}

/**
 * Every Shiny skill ships in a single plugin named `shiny`.
 * This list only gates the "view this skill" deep link — an unknown value
 * falls back to linking the repository root.
 */
const skills = [
    'localizegen',
    'shiny-aiconversation',
    'shiny-aspire-orleans',
    'shiny-blazor-hosting',
    'shiny-ble-hosting',
    'shiny-bluetoothle',
    'shiny-calendarstore',
    'shiny-contactstore',
    'shiny-controls',
    'shiny-core',
    'shiny-data-sync',
    'shiny-di',
    'shiny-discovery',
    'shiny-documentdb',
    'shiny-extensions-push',
    'shiny-firebase',
    'shiny-firestore-mobile',
    'shiny-health',
    'shiny-http-transfers',
    'shiny-httpserver',
    'shiny-jobs',
    'shiny-locations',
    'shiny-maui-hosting',
    'shiny-maui-shell',
    'shiny-mediator',
    'shiny-music',
    'shiny-notifications',
    'shiny-obd',
    'shiny-push',
    'shiny-reflector',
    'shiny-serialization',
    'shiny-spatial',
    'shiny-speech',
    'shiny-stores',
    'shiny-web-hosting',
];

const {
    skillName,
    skill,
    name,
    repoUrl = 'https://github.com/shinyorg/skills',
} = Astro.props as Props;

const requested = skillName || skill || name;
const activeSkill = requested && skills.includes(requested) ? requested : undefined;

const claudeMarketplaceAdd = 'claude plugin marketplace add shinyorg/skills';
const claudeInstallPlugin = 'claude plugin install shiny@shiny';
const copilotMarketplaceAdd = 'copilot plugin marketplace add https://github.com/shinyorg/skills';
const copilotInstallPlugin = 'copilot plugin install shiny@shiny';

const skillUrl = activeSkill
    ? `${repoUrl}/blob/main/plugins/shiny/skills/${activeSkill}/SKILL.md`
    : repoUrl;

const commands = {
    claude: { add: claudeMarketplaceAdd, install: claudeInstallPlugin },
    copilot: { add: copilotMarketplaceAdd, install: copilotInstallPlugin },
};

const copyIcon = `<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>`;
---
<div class="ai-skill not-content">
    <div class="ai-skill__tabs" role="tablist">
        <button class="ai-skill__tab ai-skill__tab--active" role="tab" aria-selected="true" data-tab="claude">Claude Code</button>
        <button class="ai-skill__tab" role="tab" aria-selected="false" data-tab="copilot">GitHub Copilot</button>
    </div>

    {(['claude', 'copilot'] as const).map((agent) => (
        <div class={`ai-skill__panel${agent === 'claude' ? ' ai-skill__panel--active' : ''}`} data-panel={agent}>
            <p class="ai-skill__section-label">Step 1 — Add the marketplace:</p>
            <div class="ai-skill__code-block">
                <code>{commands[agent].add}</code>
                <button class="ai-skill__copy" aria-label="Copy marketplace command" data-copy={commands[agent].add}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={copyIcon} />
                </button>
            </div>
            <p class="ai-skill__section-label">Step 2 — Install the plugin:</p>
            <div class="ai-skill__code-block">
                <code>{commands[agent].install}</code>
                <button class="ai-skill__copy" aria-label="Copy install command" data-copy={commands[agent].install}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={copyIcon} />
                </button>
            </div>
            <p class="ai-skill__hint">
                One plugin installs all {skills.length} Shiny skills. Your agent loads only the skill relevant to what you're building, so there's no cost to having them all available.
            </p>
        </div>
    ))}

    <a class="ai-skill__view-link" href={skillUrl} target="_blank" rel="noopener noreferrer">
        {activeSkill ? `View ${activeSkill} Skill` : 'View Skills Repository'}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
    </a>
</div>

<script>
    document.querySelectorAll('.ai-skill').forEach((container) => {
        const tabs = container.querySelectorAll('.ai-skill__tab');
        const panels = container.querySelectorAll('.ai-skill__panel');

        tabs.forEach((tab) => {
            tab.addEventListener('click', () => {
                const target = (tab as HTMLElement).dataset.tab;
                tabs.forEach((t) => {
                    t.classList.remove('ai-skill__tab--active');
                    t.setAttribute('aria-selected', 'false');
                });
                panels.forEach((p) => p.classList.remove('ai-skill__panel--active'));
                tab.classList.add('ai-skill__tab--active');
                tab.setAttribute('aria-selected', 'true');
                container.querySelector(`[data-panel="${target}"]`)?.classList.add('ai-skill__panel--active');
            });
        });

        container.querySelectorAll('.ai-skill__copy').forEach((btn) => {
            btn.addEventListener('click', () => {
                const text = (btn as HTMLElement).dataset.copy || '';
                navigator.clipboard.writeText(text).then(() => {
                    btn.classList.add('ai-skill__copy--copied');
                    setTimeout(() => btn.classList.remove('ai-skill__copy--copied'), 2000);
                });
            });
        });
    });
</script>
