---
/**
 * Every Shiny NuGet package referenced anywhere in the docs (blog excluded) or offered by the
 * App/Lib Builders. The list is collected at build time; versions and download counts are fetched
 * live in the browser by NugetCatalogTable so the page never goes stale between deploys.
 */
import { ShinyComponents } from '../consts';
import { VERSIONS } from './TemplateBuilder/templateData';
import NugetCatalogTable, { type CatalogPackage } from './NugetCatalogTable';

// Pre-Shiny packages from the aritchie nuget.org profile, with the Shiny page that replaced them
const DEPRECATED: [id: string, successor?: string][] = [
    ['Acr.UserDialogs'], ['Acr.UserDialogs.Maui'], ['Acr.UserDialogs.Uno'], ['Acr.UserDialogs.Forms'], ['Plugin.UserDialogs'],
    ['Plugin.BluetoothLE', '/client/ble/'], ['Acr.Ble', '/client/ble/'],
    ['Plugin.Jobs', '/client/jobs/'], ['Plugin.Jobs.Autofac', '/client/jobs/'], ['Plugin.Jobs.DryIoc', '/client/jobs/'],
    ['Plugin.Geofencing', '/client/locations/geofencing/'], ['Acr.Geofencing', '/client/locations/geofencing/'],
    ['Plugin.Notifications', '/client/notifications/'],
    ['Plugin.HttpTransferTasks', '/client/httptransfers/'],
    ['Plugin.SpeechRecognition', '/speech/'], ['Acr.SpeechRecognition', '/speech/'],
    ['Acr.Settings', '/stores/'],
    ['Estimotes.Xplat', '/client/beacons/'],
    ['Plugin.Sensors'], ['Acr.DeviceInfo'],
    ['Acr.Core'], ['Acr.Support'], ['Acr.Mvvm'], ['Acr.XamForms'], ['Acr.EfCore'],
];

const docs = import.meta.glob('/src/content/docs/**/*.{md,mdx}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

// name="..." on NugetBadge / NugetDownloads, plus install instructions in code blocks
const PATTERNS = [
    /\bname="(Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])"/g,
    /dotnet add package (Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])/g,
    /PackageReference Include="(Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])"/g,
    /Install-Package (Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])/g,
];

/** '/src/content/docs/client/ble/index.mdx' -> '/client/ble/' */
const toUrl = (file: string) => {
    let p = file.replace('/src/content/docs/', '').replace(/\.mdx?$/, '');
    p = p.replace(/(^|\/)index$/, '');
    return '/' + (p ? p.toLowerCase() + '/' : '');
};

/** Lower is better when picking the page to link a package to. */
const pageRank = (url: string) =>
    (url.includes('release-notes') ? 1000 : 0) + url.split('/').length * 10 + url.length / 100;

// Retired or renamed packages that still appear in docs (e.g. release notes describing the rename)
const RETIRED = new Set([
    'shiny.reflector',
    // merged into their base packages in 6.0.0 - OperatingSystem checks pick the Linux/browser backend
    'shiny.core.linux', 'shiny.core.blazor',
    'shiny.gamepad.linux', 'shiny.gamepad.blazor',
    'shiny.screenrecorder.blazor', 'shiny.bluetoothle.blazor',
    'shiny.printers.blazor', 'shiny.printing.blazor',
    'shiny.locations.blazor',
    // pulled from DocumentDb - re-released as Shiny.Geofencing.Regions / Shiny.Geofencing.Regions.DocumentDb
    'shiny.documentdb.geo', 'shiny.documentdb.geofencing',
    'shiny.appdevicebridge.documentgeofencing', 'shiny.appdevicebridge.documentgeofencing.client',
]);

const packages = new Map<string, { id: string; pages: Set<string> }>();
const add = (id: string, page?: string) => {
    const key = id.toLowerCase();
    if (RETIRED.has(key)) return;
    let entry = packages.get(key);
    if (!entry) {
        entry = { id, pages: new Set() };
        packages.set(key, entry);
    }
    if (page) entry.pages.add(page);
};

for (const [file, raw] of Object.entries(docs)) {
    if (file.startsWith('/src/content/docs/blog/')) continue;
    const url = toUrl(file);
    for (const re of PATTERNS) {
        for (const m of raw.matchAll(re)) add(m[1], url);
    }
}

for (const c of ShinyComponents) {
    for (const id of [c.nuget, c.blazorNuget, c.aspnetNuget, c.linuxNuget, ...(c.additionalNugets ?? []).map(x => x.nuget)]) {
        if (id?.startsWith('Shiny.')) add(id);
    }
}

// Current packages published to nuget.org that the docs don't name yet, with the page to link them to
const adb = (m: string, doc = '/appdevicebridge/bridges/') => [[`Shiny.AppDeviceBridge.${m}`, doc], [`Shiny.AppDeviceBridge.${m}.Client`, doc]];
const EXTRA_PACKAGES: string[][] = [
    ...['AppSupport', 'Beacons', 'BluetoothLE', 'Calendar', 'Camera', 'Contacts', 'Desktop', 'Discovery', 'Folders', 'Geofencing', 'Gps',
        'Health', 'HttpTransfers', 'Notifications', 'Obd', 'Photos', 'Printers', 'Printing', 'Push', 'RpiCamera', 'Speech', 'Wifi'].flatMap(m => adb(m)),
    ['Shiny.AppDeviceBridge.Core', '/appdevicebridge/'],
    ['Shiny.AppDeviceBridge.AppSupport.Linux', '/appdevicebridge/bridges/'],
    ['Shiny.AppDeviceBridge.AppLinks', '/appdevicebridge/bridges/'],
    ['Shiny.AppDeviceBridge.Jobs', '/appdevicebridge/background/'],
    ['Shiny.AppDeviceBridge.Client', '/appdevicebridge/clients/'],
    ['Shiny.AppDeviceBridge.Maui', '/appdevicebridge/hosting/'],
    ['Shiny.AppDeviceBridge.Tunnel', '/appdevicebridge/hosting/'],
    ['Shiny.AppDeviceBridge.MapPacks', '/appdevicebridge/maps/'],
    ['Shiny.AppDeviceBridge.Maps.Client', '/appdevicebridge/maps/'],
    ['Shiny.AppDeviceBridge.ScreenRecorder.Client', '/appdevicebridge/screenrecorder/'],
    ['Shiny.AppDeviceBridge.Wearables.Client', '/appdevicebridge/wearables/'],
    ['Shiny.AppDeviceBridge.LiveActivities.Client', '/appdevicebridge/liveactivities/'],
    ['Shiny.AppDeviceBridge.InAppPurchases.Client', '/appdevicebridge/inapppurchases/'],
    ['Shiny.AppDeviceBridge.Database.Client', '/appdevicebridge/database/'],
    ['Shiny.AppDeviceBridge.CallDirectory.Client', '/appdevicebridge/calldirectory/'],
    ['Shiny.AppDeviceBridge.GameCenter.Client', '/appdevicebridge/gamecenter/'],
    ['Shiny.AppDeviceBridge.AgeSignals.Client', '/appdevicebridge/agesignals/'],
    ['Shiny.AppDeviceBridge.Vpn.Client', '/appdevicebridge/vpn/'],
    ['Shiny.Mediator.Contracts', '/mediator/'],
    ['Shiny.Mediator.AppSupport', '/mediator/'],
    ['Shiny.Mediator.Sentry', '/mediator/'],
    ['Shiny.Mediator.Testing', '/mediator/'],
    ['Shiny.Mediator.TickerQ', '/mediator/'],
    ['Shiny.AiConversation.GithubCopilot', '/aiconversation/'],
    ['Shiny.AiConversation.MessageStores.SqliteDocDb', '/aiconversation/'],
    ['Shiny.Audio', '/speech/'],
    ['Shiny.VoiceIntelligence.DocumentDb', '/voiceintelligence/'],
    ['Shiny.Maui.Shell.ShinyDialogs', '/mauishell/'],
    // published client packages the docs never name directly - pulled in by the platform/hosting setup
    ['Shiny.BluetoothLE.Common', '/client/ble/'],
    ['Shiny.iOS.LiveActivities.Binding', '/client/liveactivities/'],
    ['Shiny.Firebase.iOS.Binding', '/client/push/firebase-ios/'],
    ['Shiny.Firebase.Firestore.iOS.Binding', '/documentdb/firestore-mobile/'],
    ['Shiny.Firebase.Firestore.Android.Binding', '/documentdb/firestore-mobile/'],
    ['Shiny.MusicKit.Binding', '/music/'],
    ['Shiny.Controls.Camera.Shared', '/controls/cameraview/analyzers/'],
    ['Shiny.Controls.Keyframe.Shared', '/controls/keyframe/'],
    ['Shiny.Controls.MediaElement.Shared', '/controls/mediaelement/'],
    ['Shiny.Controls.MotionIcons.Shared', '/controls/motion-icons/'],
    ['Shiny.Controls.Office.Shared', '/controls/spreadsheet/'],
    ['Shiny.Controls.Office.Skia', '/controls/spreadsheet/'],
    // meta-package over Shiny.Gps + Shiny.Geofencing
    ['Shiny.Locations', '/client/locations/gps/'],
    ['Shiny.AppDeviceBridge.RegionGeofencing.Client', '/appdevicebridge/region-geofencing/'],
    ['Shiny.Extensions.Reactive'],
    ['Shiny.Templates'],
];
for (const [id, doc] of EXTRA_PACKAGES) add(id, doc);

/** Groups packages into library families for display. */
const family = (id: string): string => {
    const s = id.split('.');
    if (/^Shiny\.(Maui|Blazor)\.Controls/.test(id) || id.startsWith('Shiny.Controls.') || id === 'Shiny.Maui.TableView') return 'Controls';
    if (s[1] === 'Extensions' && s[2]) return s[2] === 'Push' ? 'Push (Server)' : `Extensions`;
    if (s[1] === 'Net' && s[2]) return s[2] === 'HttpServer' ? 'HTTP Server' : `Net.${s[2]}`;
    if (s[1] === 'Mobile' && s[2]) return s[2];
    if (s[1] === 'Maui' && s[2]) return `MAUI ${s[2]}`;
    if (s[1] === 'SqliteDocumentDb') return 'DocumentDb';
    if (['Core', 'Hosting'].includes(s[1])) return 'Core';
    if (s[1] === 'MusicKit') return 'Music';
    if (s[1] === 'AspNet') return 'ASP.NET Extensions';
    if (s[1] === 'EntityFrameworkCore') return 'EF Core Extensions';
    // thermal (Shiny.Printers.*) and OS-native (Shiny.Printing.*) printing are one library family
    if (['Printers', 'Printing'].includes(s[1])) return 'Printing';
    return s[1];
};

// Stable release per family, so a just-shipped release shows before nuget.org search finishes indexing it.
// Packages on the client train get VERSIONS.shinyClient; it only applies where search reports a beta of that version.
const RELEASED: Record<string, string> = {
    'Controls': VERSIONS.shinyControls,
};

const items: CatalogPackage[] = [...packages.values()]
    .map(p => {
        const pages = [...p.pages].sort((a, b) => pageRank(a) - pageRank(b));
        const fam = family(p.id);
        return { id: p.id, family: fam, doc: pages[0], released: RELEASED[fam] ?? VERSIONS.shinyClient };
    })
    .sort((a, b) => a.family.localeCompare(b.family) || a.id.localeCompare(b.id));

// deprecated packages go last, as one section after every current Shiny family
items.push(...DEPRECATED
    .map(([id, doc]) => ({ id, family: 'Deprecated', doc, deprecated: true }))
    .sort((a, b) => a.id.localeCompare(b.id)));
---
<NugetCatalogTable packages={items} client:load />
