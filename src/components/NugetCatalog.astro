    ['Plugin.Geofencing', '/client/locations/geofencing/'], ['Acr.Geofencing', '/client/locations/geofencing/'],
    ['Plugin.Notifications', '/client/notifications/'],
    ['Plugin.HttpTransferTasks', '/client/httptransfers/'],
    ['Plugin.SpeechRecognition', '/speech/'], ['Acr.SpeechRecognition', '/speech/'],
    ['Acr.Settings', '/stores/'],
    ['Estimotes.Xplat', '/client/beacons/'],
    ['Plugin.Sensors'], ['Acr.DeviceInfo'],
    ['Acr.Core'], ['Acr.Support'], ['Acr.Mvvm'], ['Acr.XamForms'], ['Acr.EfCore'],

    // Shiny v2 / v3 / v4 packages with no current release
    ['Shiny'], ['Shiny.Framework'], ['Shiny.Testing'], ['Shiny.Msal'], ['Shiny.Sensors'], ['Shiny.Hosting.Xamarin'],
    ['Shiny.Integrations.Sqlite'], ['Shiny.Logging.AppCenter'], ['Shiny.Logging.Firebase'], ['Shiny.Logging.Sqlite'],
    ['Shiny.Locations.Common', '/client/locations/gps/'], ['Shiny.Notifications.Common', '/client/notifications/'],
    ['Shiny.Push.Common', '/client/push/'], ['Shiny.Push.OneSignal', '/client/push/'],
    ['Shiny.SpeechRecognition', '/speech/'],
    ['Shiny.Support.DeviceMonitoring', '/client/core/'], ['Shiny.Support.DeviceMonitoring.Blazor', '/client/core/'],
    ['Shiny.Support.DeviceMonitoring.Linux', '/client/core/'], ['Shiny.Support.DeviceMonitoring.Razor', '/client/core/'],
    ['Shiny.Support.Locations', '/client/locations/gps/'], ['Shiny.Support.Repositories', '/client/core/'],
    ['Shiny.Support.Storage.Blazor', '/client/core/'],
    ['Shiny.Xunit.Runners.Maui'],

    // merged into their base packages in 6.0.0 - OperatingSystem checks pick the Linux/browser backend
    ['Shiny.Core.Linux', '/client/core/'], ['Shiny.Core.Blazor', '/client/core/'],
    ['Shiny.Gamepad.Linux', '/client/gamepad/'], ['Shiny.Gamepad.Blazor', '/client/gamepad/'],
    ['Shiny.ScreenRecorder.Blazor', '/client/screenrecorder/'], ['Shiny.BluetoothLE.Blazor', '/client/ble/'],
    ['Shiny.Printers.Blazor', '/client/printing/'], ['Shiny.Printing.Blazor', '/client/printing/'],
    ['Shiny.Locations.Blazor', '/client/locations/gps/'], ['Shiny.Net.Http.Blazor', '/client/httptransfers/'],
    ['Shiny.Push.Blazor', '/client/push/'], ['Shiny.Data.Sync.Blazor', '/client/datasync/'], ['Shiny.Jobs.Blazor', '/client/jobs/'],
    ['Shiny.Firebase.Analytics.iOS.Binding', '/client/push/firebase-ios/'], ['Shiny.Firebase.Messaging.iOS.Binding', '/client/push/firebase-ios/'],
    ['Shiny.Maui.ContactStore', '/client/contactstore/'],

    // BluetoothLE Hubs and the Universal Hubs host/client packages became Shiny.UniversalHubs + a package per transport in 3.0
    ['Shiny.BluetoothLE.Hubs', '/universalhubs/upgrading/'], ['Shiny.BluetoothLE.Hubs.Host', '/universalhubs/upgrading/'],
    ['Shiny.BluetoothLE.Hubs.Client', '/universalhubs/upgrading/'],
    ['Shiny.UniversalHubs.Host', '/universalhubs/upgrading/'], ['Shiny.UniversalHubs.Client', '/universalhubs/upgrading/'],

    // geofencing pulled from DocumentDb / Spatial - re-released as Shiny.Geofencing.Regions / Shiny.Geofencing.Regions.DocumentDb
    ['Shiny.DocumentDb.Geo', '/client/locations/region-geofencing/'], ['Shiny.DocumentDb.Geofencing', '/client/locations/region-geofencing/'],
    ['Shiny.Spatial', '/client/locations/region-geofencing/'], ['Shiny.Spatial.Geofencing', '/client/locations/region-geofencing/'],

    // folded into Shiny.DocumentDb (the SQLite store was renamed to Shiny.DocumentDb.Sqlite)
    ['Shiny.SqliteDocumentDb', '/documentdb/'], ['Shiny.SqliteDocumentDb.Extensions.DependencyInjection', '/documentdb/'],
    ['Shiny.DocumentDb.Extensions.DependencyInjection', '/documentdb/'], ['Shiny.DocumentDb.Diagnostics', '/documentdb/'],

    // AppDeviceBridge bridges dropped from the repo - AppSupport folded into Shiny.AppDeviceBridge (core),
    // Locations split into Gps + Geofencing, Jobs removed with background scripts in 3.0
    ['Shiny.AppDeviceBridge.AppSupport', '/appdevicebridge/'], ['Shiny.AppDeviceBridge.AppSupport.Client', '/appdevicebridge/'],
    ['Shiny.AppDeviceBridge.AppSupport.Linux', '/appdevicebridge/'],
    ['Shiny.AppDeviceBridge.Locations', '/appdevicebridge/gps/'], ['Shiny.AppDeviceBridge.Locations.Client', '/appdevicebridge/gps/'],
    ['Shiny.AppDeviceBridge.Jobs', '/appdevicebridge/'],
    ['Shiny.AppDeviceBridge.DocumentGeofencing', '/appdevicebridge/region-geofencing/'],
    ['Shiny.AppDeviceBridge.DocumentGeofencing.Client', '/appdevicebridge/region-geofencing/'],

    // renamed to Shiny.AiConversation.Stores.SqliteDocDb in 3.0
    ['Shiny.AiConversation.MessageStores.SqliteDocDb', '/aiconversation/message-store/'],

    // Controls: standalone packages folded into the suite, camera analyzers renamed to Shiny.Maui.Controls.Analysis.* in 3.0
    ['Shiny.Maui.TableView', '/controls/tableview/'], ['Shiny.Maui.Scheduler', '/controls/scheduler/'],
    ['Shiny.Maui.MermaidDiagrams', '/controls/mermaid-diagrams/'],
    ['Shiny.Maui.Controls.TrayIcon', '/controls/trayicon/'],
    ['Shiny.Blazor.Controls.Docking', '/controls/docking/'], ['Shiny.Blazor.Controls.Kiosk', '/controls/docking/'],
    ...['Ai', 'Barcode', 'Documents', 'Face', 'Motion', 'Ocr'].map((m): [string, string] => [`Shiny.Maui.Controls.Camera.${m}`, '/controls/cameraview/analyzers/']),

    // Extensions
    ['Shiny.Reflector', '/reflector/'],
    ['Shiny.Extensions.Stores.Web', '/stores/'],
    ['Shiny.Extensions.MauiHosting'], ['Shiny.Extensions.MauiHosting.Linux'], ['Shiny.Extensions.BlazorHosting'],
    ['Shiny.Extensions.WebHosting', '/aspnet/webhosting/'], ['Shiny.Extensions.Webhooks', '/aspnet/webhooks/'],
    ['Shiny.Extensions.Localization', '/localizegen/'], ['Shiny.Extensions.Localization.AdoNet', '/localizegen/'],
    ['Shiny.Extensions.Localization.SqlServer', '/localizegen/'],
    ...['Abstractions', 'Apple', 'Ef', 'Endpoints', 'GoogleFirebase', 'Web'].map((m): [string, string] => [`Shiny.Extensions.Push.${m}`, '/extensions-push/']),
    ['Shiny.Extensions.Configuration.Sqlite'], ['Shiny.Extensions.Configuration.Remote'], ['Shiny.Extensions.Configuration.Remote.Maui'],
    ['Shiny.Extensions.Dialogs'], ['Shiny.Extensions.Dialogs.XfMaterial'], ['Shiny.Extensions.EntityFramework'],
    ['Shiny.Extensions.Mail'], ['Shiny.Extensions.Mail.Abstractions'], ['Shiny.Extensions.Mail.DotLiquid'], ['Shiny.Extensions.Mail.StorageNet'],

    // Mediator / Music / HTTP Server pieces folded into their main packages
    ['Shiny.Mediator.Caching', '/mediator/'], ['Shiny.Mediator.SourceGenerators', '/mediator/'],
    ['Shiny.Music.Sqlite', '/music/'],
    ['Shiny.Net.HttpServer.SourceGenerators', '/httpserver/'],
];
const DEPRECATED_IDS = new Set(DEPRECATED.map(([id]) => id.toLowerCase()));

const docs = import.meta.glob('/src/content/docs/**/*.{md,mdx}', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

// name="..." on NugetBadge / NugetDownloads, plus install instructions in code blocks
const PATTERNS = [
    /\bname="(Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])"/g,
    /dotnet add package (Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])/g,
    /PackageReference Include="(Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])"/g,
    /Install-Package (Shiny\.[A-Za-z0-9.]*[A-Za-z0-9])/g,
];

/** '/src/content/docs/client/ble/index.mdx' -> '/client/ble/' */
const toUrl = (file: string) => {
    let p = file.replace('/src/content/docs/', '').replace(/\.mdx?$/, '');
    p = p.replace(/(^|\/)index$/, '');
    return '/' + (p ? p.toLowerCase() + '/' : '');
};

/** Lower is better when picking the page to link a package to. */
const pageRank = (url: string) =>
    (url.includes('release-notes') ? 1000 : 0) + url.split('/').length * 10 + url.length / 100;

const packages = new Map<string, { id: string; pages: Set<string> }>();
const add = (id: string, page?: string) => {
    const key = id.toLowerCase();
    if (DEPRECATED_IDS.has(key)) return;
    let entry = packages.get(key);
    if (!entry) {
        entry = { id, pages: new Set() };
        packages.set(key, entry);
    }
    if (page) entry.pages.add(page);
};

for (const [file, raw] of Object.entries(docs)) {
    if (file.startsWith('/src/content/docs/blog/')) continue;
    const url = toUrl(file);
    for (const re of PATTERNS) {
        for (const m of raw.matchAll(re)) add(m[1], url);
    }
}

for (const c of ShinyComponents) {
    for (const id of [c.nuget, c.blazorNuget, c.aspnetNuget, c.linuxNuget, ...(c.additionalNugets ?? []).map(x => x.nuget)]) {
        if (id?.startsWith('Shiny.')) add(id);
    }
}

// Current packages published to nuget.org that the docs don't name yet, with the page to link them to
const adb = (m: string, doc = '/appdevicebridge/bridges/') => [[`Shiny.AppDeviceBridge.${m}`, doc], [`Shiny.AppDeviceBridge.${m}.Client`, doc]];
const EXTRA_PACKAGES: string[][] = [
    ...['Beacons', 'BluetoothLE', 'Calendar', 'Camera', 'Contacts', 'Desktop', 'Discovery', 'Folders', 'Geofencing', 'Gps',
        'Health', 'HttpTransfers', 'Notifications', 'Obd', 'Photos', 'Printers', 'Printing', 'Push', 'RpiCamera', 'Speech', 'Wifi'].flatMap(m => adb(m)),
    ['Shiny.AppDeviceBridge.Core', '/appdevicebridge/'],
    ['Shiny.AppDeviceBridge.AppLinks', '/appdevicebridge/bridges/'],
    ['Shiny.AppDeviceBridge.Client', '/appdevicebridge/clients/'],
    ['Shiny.AppDeviceBridge.Maui', '/appdevicebridge/hosting/'],
    ['Shiny.AppDeviceBridge.Tunnel', '/appdevicebridge/hosting/'],
    ['Shiny.AppDeviceBridge.MapPacks', '/appdevicebridge/maps/'],
    ['Shiny.AppDeviceBridge.Maps.Client', '/appdevicebridge/maps/'],
    ['Shiny.AppDeviceBridge.ScreenRecorder.Client', '/appdevicebridge/screenrecorder/'],
    ['Shiny.AppDeviceBridge.Wearables.Client', '/appdevicebridge/wearables/'],
    ['Shiny.AppDeviceBridge.LiveActivities.Client', '/appdevicebridge/liveactivities/'],
    ['Shiny.AppDeviceBridge.InAppPurchases.Client', '/appdevicebridge/inapppurchases/'],
    ['Shiny.AppDeviceBridge.Database.Client', '/appdevicebridge/database/'],
    ['Shiny.AppDeviceBridge.CallDirectory.Client', '/appdevicebridge/calldirectory/'],
    ['Shiny.AppDeviceBridge.GameCenter.Client', '/appdevicebridge/gamecenter/'],
    ['Shiny.AppDeviceBridge.AgeSignals.Client', '/appdevicebridge/agesignals/'],
    ['Shiny.AppDeviceBridge.Vpn.Client', '/appdevicebridge/vpn/'],
    ['Shiny.AppDeviceBridge.AiConversation.Client', '/appdevicebridge/aiconversation/'],
    ['Shiny.AppDeviceBridge.Audio.Client', '/appdevicebridge/audio/'],
    ['Shiny.AppDeviceBridge.Barcodes.Client', '/appdevicebridge/barcodes/'],
    ['Shiny.AppDeviceBridge.Biometrics.Client', '/appdevicebridge/biometrics/'],
    ['Shiny.AppDeviceBridge.Hubs.Client', '/appdevicebridge/hubs/'],
    ['Shiny.AppDeviceBridge.Nfc.Client', '/appdevicebridge/nfc/'],
    ['Shiny.AppDeviceBridge.ShareTarget.Client', '/appdevicebridge/share-target/'],
    ['Shiny.Mediator.Contracts', '/mediator/'],
    ['Shiny.Mediator.AppSupport', '/mediator/'],
    ['Shiny.Mediator.Sentry', '/mediator/'],
    ['Shiny.Mediator.Testing', '/mediator/'],
    ['Shiny.Mediator.TickerQ', '/mediator/'],
    ['Shiny.AiConversation.GithubCopilot', '/aiconversation/'],
    ['Shiny.AiConversation.Stores.SqliteDocDb', '/aiconversation/message-store/'],
    ['Shiny.Audio', '/audio/'],
    ['Shiny.Audio.Linux', '/audio/linux/'],
    ['Shiny.VoiceIntelligence.DocumentDb', '/voiceintelligence/'],
    ['Shiny.Maui.Shell.ShinyDialogs', '/mauishell/'],
    // published client packages the docs never name directly - pulled in by the platform/hosting setup
    ['Shiny.BluetoothLE.Common', '/client/ble/'],
    ['Shiny.iOS.LiveActivities.Binding', '/client/liveactivities/'],
    ['Shiny.Firebase.iOS.Binding', '/client/push/firebase-ios/'],
    ['Shiny.Firebase.Firestore.iOS.Binding', '/documentdb/firestore-mobile/'],
    ['Shiny.Firebase.Firestore.Android.Binding', '/documentdb/firestore-mobile/'],
    ['Shiny.MusicKit.Binding', '/music/'],
    ['Shiny.Controls.Camera.Shared', '/controls/cameraview/effects/'],
    ['Shiny.Controls.Analysis.Shared', '/controls/mediaelement/analysis/'],
    ['Shiny.Controls.BarcodeReader.Shared', '/controls/barcodes/'],
    ['Shiny.Controls.Keyframe.Shared', '/controls/keyframe/'],
    ['Shiny.Controls.MediaElement.Shared', '/controls/mediaelement/'],
    ['Shiny.Controls.MotionIcons.Shared', '/controls/motion-icons/'],
    ['Shiny.Controls.Office.Shared', '/controls/spreadsheet/'],
    ['Shiny.Controls.Office.Skia', '/controls/spreadsheet/'],
    // meta-package over Shiny.Gps + Shiny.Geofencing
    ['Shiny.Locations', '/client/locations/gps/'],
    ['Shiny.AppDeviceBridge.RegionGeofencing.Client', '/appdevicebridge/region-geofencing/'],
    ['Shiny.Gps.Linux', '/client/locations/gps/'],
    ['Shiny.Mediator.Prism', '/mediator/'],
    // DocumentDb command-line tools (dotnet tool install -g ...)
    ['ShinyDocDbMcp', '/documentdb/mcp/'],
    ['ShinyDocDbMyAdmin.Tui', '/documentdb/'],
    ['Shiny.Extensions.Reactive'],
    ['Shiny.Templates'],
];
for (const [id, doc] of EXTRA_PACKAGES) add(id, doc);

/** Groups packages into library families for display. */
const family = (id: string): string => {
    const s = id.split('.');
    if (/^Shiny\.(Maui|Blazor)\.Controls/.test(id) || id.startsWith('Shiny.Controls.') || id === 'Shiny.Maui.TableView') return 'Controls';
    if (s[1] === 'Extensions' && s[2]) return s[2] === 'Push' ? 'Push (Server)' : `Extensions`;
    if (s[1] === 'Net' && s[2]) return s[2] === 'HttpServer' ? 'HTTP Server' : `Net.${s[2]}`;
    if (s[1] === 'Mobile' && s[2]) return s[2];
    if (s[1] === 'Maui' && s[2]) return `MAUI ${s[2]}`;
    if (s[1] === 'SqliteDocumentDb' || id.startsWith('ShinyDocDb')) return 'DocumentDb';
    if (['Core', 'Hosting'].includes(s[1])) return 'Core';
    if (s[1] === 'MusicKit') return 'Music';
    if (s[1] === 'AspNet') return 'ASP.NET Extensions';
    if (s[1] === 'EntityFrameworkCore') return 'EF Core Extensions';
    // thermal (Shiny.Printers.*) and OS-native (Shiny.Printing.*) printing are one library family
    if (['Printers', 'Printing'].includes(s[1])) return 'Printing';
    return s[1];
};

// Stable release per family, so a just-shipped release shows before nuget.org search finishes indexing it.
// Packages on the client train get VERSIONS.shinyClient; it only applies where search reports a beta of that version.
const RELEASED: Record<string, string> = {
    'Controls': VERSIONS.shinyControls,
    'UniversalHubs': VERSIONS.shinyUniversalHubs,
    'AppDeviceBridge': VERSIONS.shinyAppDeviceBridge,
    'DocumentDb': VERSIONS.shinyDocumentDb,
    'HTTP Server': VERSIONS.shinyHttpServer,
};

const items: CatalogPackage[] = [...packages.values()]
    .map(p => {
        const pages = [...p.pages].sort((a, b) => pageRank(a) - pageRank(b));
        const fam = family(p.id);
        return { id: p.id, family: fam, doc: pages[0], released: RELEASED[fam] ?? VERSIONS.shinyClient };
    })
    .sort((a, b) => a.family.localeCompare(b.family) || a.id.localeCompare(b.id));

// deprecated packages go last, as one section after every current Shiny family
items.push(...DEPRECATED
    .map(([id, doc]) => ({ id, family: 'Deprecated', doc, deprecated: true }))
    .sort((a, b) => a.id.localeCompare(b.id)));
---
<NugetCatalogTable packages={items} client:load />
