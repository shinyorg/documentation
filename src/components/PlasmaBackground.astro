---
/**
 * PlasmaBackground — a faint, slowly drifting lens flare in the brand colors behind every page.
 * (The file keeps its old name so the `data-plasma` toggle and stored preference carry over.)
 *
 * A tiny WebGL fragment shader draws into a canvas at 1/2 of the viewport's size and CSS stretches
 * it to full screen. The light source wanders across the top of the page and leans toward the mouse;
 * the ghosts, halo and streak all follow it along the flare axis through the screen center.
 * It is capped at ~30fps, stops while the tab is hidden, and
 * draws a single still frame under `prefers-reduced-motion`. No WebGL → no background, nothing else.
 *
 * Starlight renders our components inside `<main>` or the fixed header, both of which can form
 * stacking contexts, so the script appends the canvas straight to `<body>`. There, `z-index: -1`
 * puts it above the body background (which propagates to the page canvas) and below all content.
 *
 * Mounted from `Banner.astro` because that override renders on every page. The header toggle in
 * `ThemeSelect.astro` sets `<html data-plasma="off">` to hide it and stop the animation loop.
 */
---

<script is:inline>
  (function () {
    if (window.__plasma) return;
    window.__plasma = true;

    var canvas = document.createElement('canvas');
    canvas.className = 'shiny-plasma';
    canvas.setAttribute('aria-hidden', 'true');
    var gl = canvas.getContext('webgl', { antialias: false, depth: false, alpha: true, powerPreference: 'low-power' });
    if (!gl) return;

    var vert = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
    // Lens flare. `l` is the light source in centered, aspect-corrected coordinates (y up, the
    // short axis spans -.5..+.5). Like a real lens, every artifact sits on the line from the light
    // through the screen center: ghosts are reflections at -k * l, so they swing across the page
    // as the light moves. Layers: soft core + bloom, slowly turning starburst rays, an anamorphic
    // horizontal streak, a chromatic halo ring, and a chain of ghost discs in the brand colors.
    var frag = [
      'precision mediump float;',
      'uniform vec2 r;uniform float t;uniform vec2 l;',
      'const vec3 purple=vec3(.416,.239,.941),green=vec3(.059,.749,.478),lime=vec3(.651,.851,0.);',
      // soft disc with a slightly brighter rim, like an aperture ghost
      'float ghost(vec2 p,vec2 c,float rad){',
      '  float d=length(p-c);',
      '  float disc=smoothstep(rad,rad*.55,d);',
      '  float rim=exp(-pow((d-rad*.92)/(rad*.12),2.));',
      '  return disc*.55+rim*.45;',
      '}',
      'void main(){',
      '  vec2 p=(gl_FragCoord.xy-.5*r)/r.y;',
      '  vec2 d=p-l;',
      '  float dist=length(d);',
      '  vec3 col=vec3(0.);',
      // core + wide bloom
      '  float core=exp(-dist*14.);',
      '  float bloom=exp(-dist*3.2);',
      '  col+=mix(lime,vec3(1.),.35)*core*1.1+purple*bloom*.4;',
      // starburst: two interleaved ray sets turning in opposite directions
      '  float a=atan(d.y,d.x);',
      '  float rays=pow(abs(sin(a*5.+t*.07)),40.)+.6*pow(abs(sin(a*8.-t*.05+1.3)),60.);',
      '  col+=mix(green,lime,.5)*rays*exp(-dist*4.5)*.9;',
      // anamorphic streak
      '  float streak=exp(-abs(d.y)*90.)*exp(-abs(d.x)*1.4);',
      '  col+=mix(purple,vec3(.75,.7,1.),.4)*streak*1.1;',
      // chromatic halo ring around the light
      '  float h=.36;',
      '  col+=purple*exp(-pow((dist-h-.012)*55.,2.))*.35;',
      '  col+=green*exp(-pow((dist-h)*55.,2.))*.35;',
      '  col+=lime*exp(-pow((dist-h+.012)*55.,2.))*.3;',
      // ghosts along the flare axis (through the center, opposite the light)
      '  col+=green *ghost(p,l*-.25,.035)*.55;',
      '  col+=purple*ghost(p,l*-.55,.09)*.40;',
      '  col+=lime  *ghost(p,l*-.80,.05)*.45;',
      '  col+=purple*ghost(p,l*-1.15,.16)*.28;',
      '  col+=green *ghost(p,l*-1.55,.07)*.40;',
      '  col+=lime  *ghost(p,l*.45,.025)*.50;',
      // big faint wash at the far end of the axis
      '  col+=mix(purple,green,.5)*exp(-length(p+l*1.9)*5.)*.25;',
      '  col=min(col,vec3(1.));',
      '  float alpha=clamp(max(col.r,max(col.g,col.b)),0.,1.);',
      '  gl_FragColor=vec4(col,alpha);',
      '}',
    ].join('\n');

    function compile(type, src) {
      var s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    }
    var vs = compile(gl.VERTEX_SHADER, vert);
    var fs = compile(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return;
    var prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    var uRes = gl.getUniformLocation(prog, 'r');
    var uTime = gl.getUniformLocation(prog, 't');
    var uLight = gl.getUniformLocation(prog, 'l');

    // Half resolution: the streak and rays are thin enough that 1/4 would visibly blur them.
    var SCALE = 2;
    function resize() {
      var w = Math.max(1, Math.ceil(window.innerWidth / SCALE));
      var h = Math.max(1, Math.ceil(window.innerHeight / SCALE));
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
        gl.viewport(0, 0, w, h);
      }
    }

    // Random phase so every page load starts somewhere different.
    var offset = Math.random() * 1000;
    // The light drifts on a slow Lissajous path across the upper part of the page and leans toward
    // the pointer, eased so the flare swings smoothly rather than snapping.
    var pointer = null;
    var light = null;
    var lastMs = 0;
    function lightTarget(t, aspect) {
      var x = Math.sin(t * 0.9) * 0.42 * aspect;
      var y = 0.2 + Math.cos(t * 1.37) * 0.14;
      if (pointer && !still.matches) {
        x += (pointer[0] * aspect - x) * 0.12;
        y += (pointer[1] - y) * 0.12;
      }
      return [x, y];
    }
    function draw(ms) {
      resize();
      var t = offset + ms * 0.00003;
      var aspect = canvas.width / canvas.height;
      var target = lightTarget(t, aspect);
      var k = light ? Math.min(1, (ms - lastMs) / 3000) : 1;
      light = light || target;
      light = [light[0] + (target[0] - light[0]) * k, light[1] + (target[1] - light[1]) * k];
      lastMs = ms;
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, t * 3);
      gl.uniform2f(uLight, light[0], light[1]);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }

    window.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      pointer = [e.clientX / window.innerWidth - 0.5, 0.5 - e.clientY / window.innerHeight];
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', function () { pointer = null; });

    var still = window.matchMedia('(prefers-reduced-motion: reduce)');
    var raf = 0;
    var last = 0;
    function loop(ms) {
      raf = requestAnimationFrame(loop);
      if (ms - last < 33) return;
      last = ms;
      draw(ms);
    }
    function enabled() {
      return document.documentElement.dataset.plasma !== 'off';
    }
    function start() {
      cancelAnimationFrame(raf);
      raf = 0;
      canvas.style.display = enabled() ? '' : 'none';
      if (!enabled()) return;
      if (still.matches || document.hidden) draw(performance.now());
      else raf = requestAnimationFrame(loop);
    }

    window.addEventListener('resize', function () { if (!raf && enabled()) draw(performance.now()); });
    // Fired by the header toggle in ThemeSelect.astro.
    window.addEventListener('shiny-plasma-change', start);
    document.addEventListener('visibilitychange', start);
    if (still.addEventListener) still.addEventListener('change', start);

    function mount() {
      document.body.appendChild(canvas);
      start();
    }
    if (document.body) mount();
    else document.addEventListener('DOMContentLoaded', mount);
  })();
</script>

<style is:global>
  .shiny-plasma {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    opacity: 0.2;
  }

  :root[data-plasma='off'] .shiny-plasma {
    display: none;
  }

  :root[data-theme='dark'] .shiny-plasma {
    opacity: 0.3;
  }

  @media print {
    .shiny-plasma {
      display: none;
    }
  }
</style>
