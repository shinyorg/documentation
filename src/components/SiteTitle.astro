---
/**
 * Site title + the header's "Browse docs" trigger.
 *
 * The finder started life as a homepage-only panel. Hanging its trigger
 * off the title puts the same topic map one click away from every page, and
 * `data-finder-anchor="header"` tells the finder to drop out of the toolbar
 * rather than float centre-screen.
 *
 * Desktop only — below 50rem the header's ⋮ menu carries a Browse entry.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<Default><slot /></Default>

<button
  class="nav-browse print:hidden"
  type="button"
  data-open-finder
  data-finder-anchor="header"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="finder"
>
  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.6"/></svg>
  <span>Browse docs</span>
  <kbd>/</kbd>
  <svg class="chev" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
</button>

<style>
  .nav-browse {
    display: none;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    margin-inline-start: var(--sl-nav-gap);
    padding: 0.34rem 0.6rem 0.34rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 650;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
  }

  @media (min-width: 50rem) {
    .nav-browse { display: inline-flex; }
  }

  /* The grid icon carries the brand gradient so the button reads as "ours"
     next to Starlight's own neutral search control. */
  .nav-browse > svg:first-of-type { color: var(--shiny-purple-vivid); flex-shrink: 0; }

  .nav-browse kbd {
    padding: 0.12rem 0.32rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.28rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .nav-browse .chev {
    color: var(--sl-color-gray-3);
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-browse:hover,
  .nav-browse:focus-visible {
    border-color: color-mix(in srgb, var(--shiny-purple-vivid) 55%, transparent);
    background: color-mix(in srgb, var(--shiny-purple-vivid) 9%, var(--sl-color-bg));
  }

  .nav-browse.is-open {
    border-color: transparent;
    background: linear-gradient(118deg,
      color-mix(in srgb, var(--shiny-purple-vivid) 20%, var(--sl-color-bg)),
      color-mix(in srgb, var(--shiny-green-vivid) 18%, var(--sl-color-bg)));
  }

  .nav-browse.is-open .chev { transform: rotate(180deg); }

  /* Tight toolbars: keep the affordance, drop the ornament. */
  @media (max-width: 72rem) {
    .nav-browse kbd { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-browse .chev { transition: none; }
  }
</style>
