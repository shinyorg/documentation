---
import DatabaseIcon from './DatabaseIcon.astro';
import { providers, providerGroups } from './providers';

export interface Props {
    /** `compact` = a wrapping strip of icon chips (homepage card); `full` = grouped, labelled tiles */
    variant?: 'compact' | 'full';
}

const { variant = 'full' } = Astro.props as Props;
---
{variant === 'compact' ? (
    <div class="dbp-strip not-content" aria-label={`${providers.length} supported databases`}>
        {providers.map(p => (
            <a class="dbp-chip" href={p.href} title={p.name} style={`--db-c:${p.color};--db-cd:${p.dark ?? p.color}`}>
                <DatabaseIcon id={p.id} size="1.35rem" />
                <span class="dbp-chip-label">{p.name}</span>
            </a>
        ))}
    </div>
) : (
    <div class="dbp-full not-content">
        {providerGroups.map(g => (
            <section class="dbp-group">
                <header class="dbp-group-header">
                    <h3 class="dbp-group-title">{g.title}</h3>
                    <p class="dbp-group-blurb">{g.blurb}</p>
                </header>
                <div class="dbp-grid">
                    {providers.filter(p => p.group === g.id).map(p => (
                        <a class="dbp-tile" href={p.href} style={`--db-c:${p.color};--db-cd:${p.dark ?? p.color}`}>
                            <span class="dbp-badge"><DatabaseIcon id={p.id} size="1.6rem" /></span>
                            <span class="dbp-text">
                                <span class="dbp-name">{p.name}</span>
                                <span class="dbp-tagline">{p.tagline}</span>
                            </span>
                        </a>
                    ))}
                </div>
            </section>
        ))}
    </div>
)}

<style>
    /* ── compact strip ─────────────────────────────────────────── */
    .dbp-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin: 0.9rem 0 1.1rem;
    }

    .dbp-chip {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.65rem;
        border: 1px solid color-mix(in srgb, var(--db-c) 22%, var(--sl-color-gray-6));
        background: color-mix(in srgb, var(--db-c) 9%, var(--sl-color-bg));
        text-decoration: none;
        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    :global(:root[data-theme='dark']) .dbp-chip {
        border-color: color-mix(in srgb, var(--db-cd) 30%, transparent);
        background: color-mix(in srgb, var(--db-cd) 12%, transparent);
    }

    .dbp-chip:hover,
    .dbp-chip:focus-visible {
        transform: translateY(-2px);
        border-color: var(--db-c);
        box-shadow: 0 6px 16px color-mix(in srgb, var(--db-c) 35%, transparent);
    }

    :global(:root[data-theme='dark']) .dbp-chip:hover,
    :global(:root[data-theme='dark']) .dbp-chip:focus-visible {
        border-color: var(--db-cd);
        box-shadow: 0 6px 16px color-mix(in srgb, var(--db-cd) 30%, transparent);
    }

    /* name bubble on hover / keyboard focus */
    .dbp-chip-label {
        position: absolute;
        bottom: calc(100% + 0.4rem);
        left: 50%;
        z-index: 5;
        padding: 0.2rem 0.5rem;
        border-radius: 0.4rem;
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.3;
        white-space: nowrap;
        color: var(--sl-color-black);
        background: var(--sl-color-white);
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, 0.2rem);
        transition: opacity 0.15s ease, transform 0.15s ease;
    }

    .dbp-chip:hover .dbp-chip-label,
    .dbp-chip:focus-visible .dbp-chip-label {
        opacity: 1;
        transform: translate(-50%, 0);
    }

    /* ── full grouped grid ─────────────────────────────────────── */
    .dbp-full {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        margin: 1.25rem 0 2rem;
    }

    .dbp-group-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.75rem;
        margin-bottom: 0.7rem;
    }

    .dbp-group-title {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--sl-color-text-accent);
    }

    .dbp-group-blurb {
        margin: 0;
        font-size: 0.85rem;
        color: var(--sl-color-gray-3);
    }

    .dbp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
        gap: 0.65rem;
    }

    .dbp-tile {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 0.85rem;
        border-radius: 0.8rem;
        border: 1px solid var(--sl-color-gray-6);
        background: var(--sl-color-bg);
        color: inherit;
        text-decoration: none;
        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }

    :global(:root[data-theme='dark']) .dbp-tile {
        border-color: var(--sl-color-gray-5);
        background: rgba(255, 255, 255, 0.03);
    }

    .dbp-tile:hover,
    .dbp-tile:focus-visible {
        transform: translateY(-2px);
        border-color: var(--db-c);
        box-shadow: 0 8px 22px color-mix(in srgb, var(--db-c) 22%, transparent);
    }

    :global(:root[data-theme='dark']) .dbp-tile:hover,
    :global(:root[data-theme='dark']) .dbp-tile:focus-visible {
        border-color: var(--db-cd);
        box-shadow: 0 8px 22px color-mix(in srgb, var(--db-cd) 22%, transparent);
    }

    .dbp-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 0.65rem;
        background: color-mix(in srgb, var(--db-c) 10%, transparent);
    }

    :global(:root[data-theme='dark']) .dbp-badge {
        background: color-mix(in srgb, var(--db-cd) 14%, transparent);
    }

    .dbp-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .dbp-name {
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1.3;
        color: var(--sl-color-white);
    }

    .dbp-tagline {
        font-size: 0.78rem;
        line-height: 1.35;
        color: var(--sl-color-gray-3);
    }

    @media (prefers-reduced-motion: reduce) {
        .dbp-chip, .dbp-tile, .dbp-chip-label { transition: none; }
        .dbp-chip:hover, .dbp-tile:hover { transform: none; }
    }
</style>
