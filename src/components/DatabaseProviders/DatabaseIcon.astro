---
import { getProvider } from './providers';

export interface Props {
    id: string;
    /** CSS length for the rendered glyph */
    size?: string;
    class?: string;
}

const { id, size = '1.15em', class: className } = Astro.props as Props;
const p = getProvider(id);
const isStroke = p.icon.kind === 'stroke';
---
<svg
    class:list={['db-icon', className]}
    style={`--db-c:${p.color};--db-cd:${p.dark ?? p.color};width:${size};height:${size}`}
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    fill={isStroke ? 'none' : 'currentColor'}
    stroke={isStroke ? 'currentColor' : undefined}
    stroke-width={isStroke ? '2' : undefined}
    stroke-linecap={isStroke ? 'round' : undefined}
    stroke-linejoin={isStroke ? 'round' : undefined}
    role="img"
    aria-label={p.name}
    set:html={p.icon.body}
/>

<style>
    .db-icon {
        display: inline-block;
        flex-shrink: 0;
        vertical-align: -0.2em;
        color: var(--db-c);
    }

    :global(:root[data-theme='dark']) .db-icon {
        color: var(--db-cd);
    }
</style>
