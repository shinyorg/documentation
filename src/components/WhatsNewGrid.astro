---
import { Icon } from '@astrojs/starlight/components';
import { whatsNewByDate } from '../data/whatsNew';

interface Props {
  /** Show only the newest N entries; omit for all of them. */
  limit?: number;
}

const { limit } = Astro.props;
const items = limit ? whatsNewByDate().slice(0, limit) : whatsNewByDate();
const formatDate = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<div class="ai-card-grid whats-new not-content" data-stagger="up" data-stagger-step="60">
  {items.map((item) => (
    <a class="ai-card" data-spotlight href={item.href}>
      <span class="ai-card-icon"><Icon name={item.icon as any} /></span>
      <time class="whats-new-date" datetime={item.date}>{formatDate(item.date)}</time>
      <span class="ai-card-title">{item.title}{item.tag && <small> ({item.tag})</small>}</span>
      <span class="ai-card-desc" set:html={item.description} />
      <span class="ai-card-more">Explore<Icon name="right-arrow" /></span>
    </a>
  ))}
</div>
