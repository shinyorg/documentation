---
/**
 * Every App Device Bridge bridge as a card: its route prefix, how many requests and events it has, and its events.
 * Counts and events come from src/data/appdevicebridge/bridges.json (scripts/extract-bridges.mjs).
 */
import data from '../data/appdevicebridge/bridges.json';

type Bridge = { name: string; summary: string; prefix: string; requests: unknown[]; events: { event: string }[] };

// Display order, label and page for each bridge. A bridge missing here is still shown, at the end.
const pages: Record<string, { label: string; href: string; builtIn?: boolean }> = {
  HostBridge: { label: 'Host', href: '/appdevicebridge/updates/#requests', builtIn: true },
  SettingsBridge: { label: 'Settings', href: '/appdevicebridge/storage/#requests', builtIn: true },
  FilesBridge: { label: 'Files', href: '/appdevicebridge/storage/#requests', builtIn: true },
  LinksBridge: { label: 'App links', href: '/appdevicebridge/app-links/', builtIn: true },
  AppBridge: { label: 'App support', href: '/appdevicebridge/app-support/' },
  SensorsBridge: { label: 'Sensors', href: '/appdevicebridge/sensors/' },
  GpsBridge: { label: 'GPS', href: '/appdevicebridge/gps/' },
  MotionBridge: { label: 'Motion activity', href: '/appdevicebridge/gps/#motion-activity' },
  GeocodingBridge: { label: 'Reverse geocoding', href: '/appdevicebridge/gps/#reverse-geocoding' },
  GeofencesBridge: { label: 'Geofences', href: '/appdevicebridge/geofencing/' },
  DocumentGeofencesBridge: { label: 'Document geofences', href: '/appdevicebridge/document-geofencing/' },
  BeaconsBridge: { label: 'Beacons', href: '/appdevicebridge/beacons/' },
  BluetoothLEBridge: { label: 'Bluetooth LE', href: '/appdevicebridge/bluetoothle/' },
  ObdBridge: { label: 'OBD-II', href: '/appdevicebridge/obd/' },
  PrintersBridge: { label: 'Receipt printers', href: '/appdevicebridge/printing/#receipt-printers' },
  PrintingBridge: { label: 'OS printing', href: '/appdevicebridge/printing/#os-printing' },
  WifiBridge: { label: 'Wi-Fi', href: '/appdevicebridge/wifi/' },
  DiscoveryBridge: { label: 'Discovery', href: '/appdevicebridge/discovery/' },
  NotificationsBridge: { label: 'Notifications', href: '/appdevicebridge/notifications/' },
  PushBridge: { label: 'Push', href: '/appdevicebridge/push/' },
  TransfersBridge: { label: 'HTTP transfers', href: '/appdevicebridge/http-transfers/' },
  WearablesBridge: { label: 'Wearables', href: '/appdevicebridge/wearables/' },
  LiveActivitiesBridge: { label: 'Live activities', href: '/appdevicebridge/liveactivities/' },
  InAppPurchasesBridge: { label: 'In-app purchases', href: '/appdevicebridge/inapppurchases/' },
  MapsBridge: { label: 'Maps', href: '/appdevicebridge/maps/' },
  DirectionsBridge: { label: 'Directions', href: '/appdevicebridge/maps/#directions' },
  HealthBridge: { label: 'Health', href: '/appdevicebridge/health/' },
  SpeechBridge: { label: 'Speech', href: '/appdevicebridge/speech/' },
  ScreenRecorderBridge: { label: 'Screen recorder', href: '/appdevicebridge/screenrecorder/' },
  ContactsBridge: { label: 'Contacts', href: '/appdevicebridge/contacts/' },
  CalendarBridge: { label: 'Calendar', href: '/appdevicebridge/calendar/' },
  PhotosBridge: { label: 'Photos', href: '/appdevicebridge/photos/' },
  FoldersBridge: { label: 'Folders', href: '/appdevicebridge/folders/' },
  DatabaseBridge: { label: 'Database', href: '/appdevicebridge/database/' },
  TrayBridge: { label: 'Tray icon', href: '/appdevicebridge/desktop/#tray-icon' },
  QuickEntryBridge: { label: 'Quick entry', href: '/appdevicebridge/desktop/#quick-entry' },
  CameraBridge: { label: 'Device camera', href: '/appdevicebridge/camera/' },
  RpiCameraBridge: { label: 'Pi camera', href: '/appdevicebridge/rpicamera/' },
};

const order = Object.keys(pages);
const bridges = [...(data.bridges as Bridge[])].sort((a, b) => {
  const ia = order.indexOf(a.name), ib = order.indexOf(b.name);
  return (ia < 0 ? 999 : ia) - (ib < 0 ? 999 : ib);
});

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const lead = (s: string) => {
  const first = s.split(/\n\n/)[0];
  const m = first.match(/^(.+?[.!?])(\s|$)/);
  return esc(m ? m[1] : first).replace(/`+([^`]+?)`+/g, '<code>$1</code>');
};

const totals = {
  bridges: bridges.length,
  requests: bridges.reduce((n, b) => n + b.requests.length, 0),
  events: bridges.reduce((n, b) => n + b.events.length, 0),
};
---

<div class="bridge-catalog not-content">
  <div class="bc-totals">
    <div><strong>{totals.bridges}</strong><span>bridges</span></div>
    <div><strong>{totals.requests}</strong><span>requests</span></div>
    <div><strong>{totals.events}</strong><span>events</span></div>
  </div>
  <div class="bc-grid">
    {bridges.map((b) => {
      const page = pages[b.name] ?? { label: b.name.replace(/Bridge$/, ''), href: '#' };
      return (
        <a class="bc-card" href={page.href}>
          <div class="bc-head">
            <span class="bc-name">{page.label}</span>
            {page.builtIn && <span class="bc-builtin">built in</span>}
          </div>
          <code class="bc-prefix">/_bridge/{b.prefix}</code>
          <p class="bc-lead" set:html={lead(b.summary)} />
          <div class="bc-counts">
            <span><b>{b.requests.length}</b> {b.requests.length === 1 ? 'request' : 'requests'}</span>
            <span><b>{b.events.length}</b> {b.events.length === 1 ? 'event' : 'events'}</span>
          </div>
          {b.events.length > 0 && (
            <div class="bc-events">{b.events.map((e) => <code>{e.event}</code>)}</div>
          )}
        </a>
      );
    })}
  </div>
</div>

<style is:global>
  .bridge-catalog {
    margin-top: 1.25rem;
  }
  .bridge-catalog .bc-totals {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .bridge-catalog .bc-totals div {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
  }
  .bridge-catalog .bc-totals strong {
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--sl-color-text-accent);
  }
  .bridge-catalog .bc-totals span {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bridge-catalog .bc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
  }
  .bridge-catalog .bc-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg);
    text-decoration: none;
    color: var(--sl-color-gray-2);
    transition: border-color 0.15s, transform 0.15s;
  }
  .bridge-catalog .bc-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-1px);
  }
  .bridge-catalog .bc-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .bridge-catalog .bc-name {
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .bridge-catalog .bc-builtin {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.05rem 0.4rem;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
  .bridge-catalog .bc-prefix {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-text-accent);
  }
  .bridge-catalog .bc-lead {
    margin: 0;
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .bridge-catalog .bc-counts {
    display: flex;
    gap: 0.9rem;
    margin-top: auto;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .bridge-catalog .bc-counts b {
    color: var(--sl-color-white);
  }
  .bridge-catalog .bc-events {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .bridge-catalog .bc-events code {
    font-size: 0.68rem;
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    color: #7c5cea;
    background: color-mix(in srgb, #7c5cea 12%, transparent);
  }
  :root[data-theme='dark'] .bridge-catalog .bc-events code {
    color: #b9a3ff;
  }
</style>
