---
/**
 * "Behind Shiny" — the maintainer card and the Gone .NET channel card.
 *
 * These used to be two full-width gradient slabs stacked at the foot of the
 * homepage, both saying "here is a person, here are some links". Pairing them
 * in one section halves the scroll and lets the credentials (MVP, downloads,
 * years) read as data instead of prose.
 */
import { Image } from 'astro:assets';
import allanImg from '../assets/allanritchie.jpg';
import goneNetImg from '../assets/gonedotnet.jpg';

const stats = [
  { v: '25+', l: 'years in .NET' },
  { v: '10×', l: 'Microsoft MVP' },
  { v: '40M+', l: 'NuGet downloads' },
];

const links = [
  { href: 'mailto:allan@shinysoft.biz', label: 'Get in Touch', primary: true },
  { href: 'https://allanritchie.com', label: 'Blog' },
  { href: 'https://mvp.microsoft.com/en-us/PublicProfile/5002565', label: 'MVP Profile' },
  { href: 'https://github.com/aritchie', label: 'GitHub' },
];
---

<div class="behind not-content">
  <!-- ── Maintainer ─────────────────────────────────────────── -->
  <article class="card person">
    <header class="person-head">
      <span class="avatar">
        <Image src={allanImg} width={220} height={220} alt="Allan Ritchie" loading="lazy" />
      </span>
      <span class="person-id">
        <span class="person-name">Allan Ritchie</span>
        <span class="person-role">Creator &amp; maintainer of Shiny.NET</span>
        <span class="person-tags">
          <span class="tag mvp">
            <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true"><path d="M12 2 9.2 8.6 2 9.3l5.5 4.8L5.8 21 12 17.3 18.2 21l-1.7-6.9L22 9.3l-7.2-.7Z"/></svg>
            10× Microsoft MVP
          </span>
          <span class="tag oss">Open Source Maintainer</span>
        </span>
      </span>
    </header>

    <p class="person-bio">
      A software engineer with 25+ years specializing in .NET architecture across cloud, mobile,
      desktop and web. Building cross-platform .NET libraries since the early Xamarin days —
      those packages have now been downloaded over 40 million times on NuGet.
    </p>

    <dl class="person-stats">
      {stats.map((s) => (
        <div>
          <dt>{s.v}</dt>
          <dd>{s.l}</dd>
        </div>
      ))}
    </dl>

    <p class="person-ask">Need help integrating Shiny, or consulting support?</p>

    <div class="person-links">
      {links.map((l) => (
        <a
          href={l.href}
          class={l.primary ? 'plink primary' : 'plink'}
          {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {l.label}
        </a>
      ))}
    </div>
  </article>

  <!-- ── Gone .NET ──────────────────────────────────────────── -->
  <article class="card channel">
    <a class="channel-art" href="https://youtube.com/@GoneDotNet" target="_blank" rel="noopener noreferrer" aria-label="Gone .NET on YouTube">
      <Image src={goneNetImg} width={360} height={361} alt="" loading="lazy" />
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z"/></svg>
      </span>
    </a>

    <div class="channel-body">
      <span class="channel-kicker">
        <span class="live-dot" aria-hidden="true"></span>
        New episode every week
      </span>
      <h3>Gone .NET</h3>
      <p class="channel-hosts">
        <a href="https://github.com/aritchie" target="_blank" rel="noopener noreferrer">Allan Ritchie</a>
        <span aria-hidden="true">&amp;</span>
        <a href="https://github.com/redth" target="_blank" rel="noopener noreferrer">Jon Dick</a>
      </p>
      <p class="channel-copy">
        .NET deep dives, library walkthroughs and community discussions — the two of them
        working through the same problems these libraries were built to solve.
      </p>
      <a class="yt" href="https://youtube.com/@GoneDotNet" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
        Watch on YouTube
      </a>
    </div>
  </article>
</div>

<style>
  .behind {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: stretch;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.5rem;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 1rem;
    background: var(--sl-color-bg);
  }

  :root[data-theme='dark'] .card {
    border-color: var(--sl-color-gray-5);
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, var(--sl-color-bg));
  }

  /* ─────────────────────────────────────────────────────────────
     Maintainer
     ───────────────────────────────────────────────────────────── */
  .person-head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.05rem;
  }

  /* Gradient ring: a conic sweep of the brand hues behind a masked disc,
     so the avatar sits in the palette instead of a flat purple hoop. */
  .avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 5.4rem;
    height: 5.4rem;
    border-radius: 50%;
    background: conic-gradient(from 210deg,
      var(--shiny-purple-vivid),
      var(--shiny-green-vivid),
      var(--shiny-lime-vivid),
      var(--shiny-purple-vivid));
  }

  .avatar :global(img) {
    width: calc(100% - 6px);
    height: calc(100% - 6px);
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--sl-color-bg);
  }

  :root[data-theme='dark'] .avatar :global(img) {
    border-color: color-mix(in srgb, var(--sl-color-gray-6) 45%, var(--sl-color-bg));
  }

  .person-id { display: flex; flex-direction: column; gap: 0.22rem; min-width: 0; }

  .person-name {
    color: var(--sl-color-white);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .person-role {
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .person-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.3rem; }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .tag.mvp { background: linear-gradient(135deg, #0078d4, #50a0e0); color: #fff; }

  .tag.oss {
    background: color-mix(in srgb, var(--shiny-purple-vivid) 14%, transparent);
    color: var(--shiny-purple-vivid);
  }

  .person-bio {
    margin: 0 0 1.1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  /* ── Credentials as data ─────────────────────────────────── */
  .person-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0 0 1.1rem;
    padding: 0.85rem 0;
    border-block: 1px solid var(--sl-color-gray-6);
  }

  :root[data-theme='dark'] .person-stats { border-block-color: var(--sl-color-gray-5); }

  .person-stats div { display: flex; flex-direction: column; gap: 0.1rem; }

  .person-stats dt {
    background: linear-gradient(118deg, var(--shiny-purple-vivid), var(--shiny-green-vivid));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: 1.35rem;
    font-weight: 850;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .person-stats dd {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .person-ask {
    margin: 0 0 0.7rem;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: auto;
  }

  .plink {
    display: inline-flex;
    align-items: center;
    padding: 0.42rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .plink:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--shiny-purple-vivid) 55%, transparent);
    background: color-mix(in srgb, var(--shiny-purple-vivid) 10%, transparent);
  }

  .plink.primary {
    border-color: transparent;
    background: linear-gradient(118deg, var(--shiny-purple-vivid), var(--shiny-green-vivid));
    color: #fff;
  }

  .plink.primary:hover {
    box-shadow: 0 8px 20px color-mix(in srgb, var(--shiny-purple-vivid) 38%, transparent);
  }

  /* ─────────────────────────────────────────────────────────────
     Gone .NET
     ───────────────────────────────────────────────────────────── */
  .channel {
    position: relative;
    align-items: center;
    text-align: center;
    overflow: hidden;
  }

  /* A soft YouTube-red bloom behind the artwork — enough to signal "video"
     without turning the card into an ad. */
  .channel::before {
    content: '';
    position: absolute;
    top: -35%;
    left: 50%;
    width: 22rem;
    height: 22rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 0, 0, 0.16), transparent 68%);
    pointer-events: none;
  }

  .channel-art {
    position: relative;
    display: block;
    width: 9.5rem;
    margin-bottom: 1rem;
    border-radius: 1rem;
    line-height: 0;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .channel-art :global(img) {
    width: 100%;
    height: auto;
    border-radius: 1rem;
    box-shadow: 0 10px 28px rgba(10, 8, 22, 0.28);
  }

  .play {
    position: absolute;
    right: -0.5rem;
    bottom: -0.5rem;
    display: grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    border: 3px solid var(--sl-color-bg);
    background: #FF0000;
    color: #fff;
    box-shadow: 0 6px 16px rgba(255, 0, 0, 0.42);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :root[data-theme='dark'] .play {
    border-color: color-mix(in srgb, var(--sl-color-gray-6) 45%, var(--sl-color-bg));
  }

  .channel-art:hover { transform: translateY(-3px); }
  .channel-art:hover .play { transform: scale(1.1); }

  .channel-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    flex: 1;
  }

  .channel-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.16rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, #FF0000 12%, transparent);
    color: #E5484D;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }

  :root[data-theme='dark'] .channel-kicker { color: #FF8A8A; }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .channel h3 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .channel-hosts {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .channel-hosts a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .channel-hosts a:hover { color: var(--sl-color-text-accent); }

  .channel-copy {
    margin: 0.3rem 0 1.1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.87rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .yt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: #FF0000;
    color: #fff;
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .yt:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(255, 0, 0, 0.42);
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 56rem) {
    .behind { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 30rem) {
    .person-head { flex-direction: column; align-items: flex-start; gap: 0.85rem; }
    .person-stats { gap: 0.4rem; }
    .person-stats dt { font-size: 1.15rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-art, .play, .plink, .yt { transition: none; }
    .channel-art:hover, .channel-art:hover .play, .plink:hover, .yt:hover { transform: none; }
    .live-dot { animation: none; }
  }
</style>
