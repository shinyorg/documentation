---
// WebMCP bootstrap: registers read-only tools (search the docs, read a page,
// list/get the Shiny AI skills and libraries) with an AI agent in the browser.
// Rendered on every page from `Header.astro`.
//
// Browsers without `document.modelContext` load nothing past this check: no
// module, no catalog, no Pagefind. Today the API sits behind
// chrome://flags/#enable-webmcp-testing (edge://flags/... in Edge).
// Tools live in `src/scripts/webmcp.ts`; data in /webmcp/index.json.
---

<script>
  type Api = { registerTool?: unknown };
  const api = ((document as unknown as { modelContext?: Api }).modelContext ??
    (navigator as unknown as { modelContext?: Api }).modelContext) as Api | undefined;
  if (api && typeof api.registerTool === 'function') {
    import('../scripts/webmcp').then(({ registerWebMCPTools }) =>
      registerWebMCPTools(api as Parameters<typeof registerWebMCPTools>[0])
    );
  }
</script>
