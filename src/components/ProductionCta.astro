---
/**
 * ProductionCta — the "shipping this to production?" box at the foot of the
 * high-intent doc sections (background BLE, jobs, GPS, push, transfers, sync).
 *
 * Mounted by MarkdownContent.astro for any page whose entry id starts with one
 * of the prefixes below, so no individual page has to opt in. Release notes are
 * skipped — readers there are upgrading, not evaluating.
 *
 * The booking link lives in CTA_HREF; change it there when a scheduling page
 * (Calendly, Cal.com, Bookings) replaces the contact form, or point it at
 * /services/mobile-iot/ once that page is live. UTMs follow the convention in
 * BizSites/shinysoft/plan-positioning-followups.md (source = shinylib, medium = docs,
 * campaign = the service line) — every topic below is the mobile & IoT line.
 */

const CTA_HREF = 'https://shinysoft.biz/contact?utm_source=shinylib&utm_medium=docs&utm_campaign=mobile-iot';

const topics = [
  { prefix: 'client/blehosting/', pain: 'Advertising and GATT servers that survive backgrounding' },
  { prefix: 'client/ble/', pain: 'Background BLE, reconnects and OEM quirks' },
  { prefix: 'client/jobs/', pain: 'Background jobs the OS actually runs' },
  { prefix: 'client/locations/', pain: 'Background GPS and geofences that keep firing' },
  { prefix: 'client/push/', pain: 'Push delivery across APNs, Firebase and Azure' },
  { prefix: 'client/httptransfers/', pain: 'Large background transfers on flaky networks' },
  { prefix: 'client/datasync/', pain: 'Offline sync and conflict resolution' },
  { prefix: 'foundation/xamarin-migration/', pain: 'Xamarin migrations with background BLE, location or sync' },
];

const id: string = Astro.locals.starlightRoute?.entry?.id ?? '';
const topic = id.endsWith('release-notes') ? undefined : topics.find((t) => id.startsWith(t.prefix) || `${id}/` === t.prefix);
---

{topic && (
  <aside class="production-cta not-content" aria-label="Commercial support">
    <p class="production-cta-title">Shipping this to production?</p>
    <p class="production-cta-body">
      {topic.pain} — this is where projects stall. Talk to the people who maintain this library.
    </p>
    <a class="production-cta-link" href={CTA_HREF} target="_blank" rel="noopener noreferrer">
      Book 30 minutes with ShinySoft <span aria-hidden="true">→</span>
    </a>
    <a class="production-cta-secondary" href="/foundation/support/#commercial-support">What commercial support covers</a>
  </aside>
)}

<style>
  .production-cta {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-inline-start-width: 4px;
    border-radius: 0.5rem;
    background: var(--sl-color-accent-low);
  }

  .production-cta-title {
    margin: 0;
    font-weight: 600;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }

  .production-cta-body {
    margin: 0.35rem 0 0.75rem;
    color: var(--sl-color-gray-2);
  }

  .production-cta-link {
    font-weight: 600;
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  .production-cta-secondary {
    margin-inline-start: 1.25rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .production-cta-link:hover {
    text-decoration: underline;
  }
</style>
