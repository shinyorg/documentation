---
export interface Props {
    name: string;
}

const { name } = Astro.props as Props;

const shieldsUrl = `https://img.shields.io/nuget/dt/${name}?style=for-the-badge&logo=nuget&label=${encodeURIComponent(name)}`;
const nugetUrl = `https://www.nuget.org/packages/${name}`;
const t = Astro.locals.t;
---
<a href={nugetUrl} target="_blank" rel="noopener noreferrer"><img src={shieldsUrl} alt={t('nugetDownloads.alt').replace('{name}', name)} /></a>
