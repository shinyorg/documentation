---
/**
 * Banner — the rotating announcement bar, kept out of the search index.
 *
 * `starlight-announcement` overrides Starlight's own `Banner`, and Starlight
 * renders the banner *inside* `<main data-pagefind-body>`. Starlight's default
 * Banner carries `data-pagefind-ignore` for exactly this reason; the plugin's
 * replacement does not, so without this wrapper every one of the ~670 pages
 * indexes all ten announcement strings — "OBD" would match the whole site, and
 * every full-text excerpt would open with banner copy.
 *
 * The plugin sets `components.Banner` unconditionally in its `config:setup`,
 * clobbering a plain override — so `astro.config.mjs` re-points `Banner` here
 * from a plugin listed *after* it (plugins are applied in array order).
 *
 * `display: contents` keeps the box tree identical to the unwrapped banner;
 * Pagefind still honours the attribute.
 */
import AnnouncementBanner from 'starlight-announcement/components/AnnouncementBanner.astro';
---

<div data-pagefind-ignore style="display: contents">
  <AnnouncementBanner />
</div>
