---
/**
 * Homepage motion: scroll reveals, split-word headings, parallax, pointer depth and spotlight,
 * marquee velocity and a scroll progress bar. The same system as shinysoft.biz — see
 * src/scripts/motion.ts for the attributes the markup uses to opt in.
 *
 * Place it first in the page body, ahead of anything that reveals.
 */
import '../styles/motion.css';
---

<!--
  Motion gate. Runs before the content below it is parsed, so elements that reveal on scroll start
  hidden instead of flashing in and then vanishing. Skipped for reduced motion, and undone if the
  motion module has not booted within a few seconds — content must never stay hidden because a
  script failed to load.
-->
<script is:inline>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    var root = document.documentElement;
    root.classList.add('motion');
    setTimeout(function () {
      if (!window.__motion) root.classList.remove('motion');
    }, 3000);
  })();
</script>

<div class="scroll-progress" aria-hidden="true"></div>

<script>
  import '../scripts/motion';
</script>
