---
/**
 * NewsletterSignup — the monthly newsletter form.
 *
 * shinylib.net is on GitHub Pages, so the list lives on a site the BizSites server does host (`api`,
 * shinysoft.biz) and this form posts to it cross-origin: GET /api/contact/token, then
 * POST /api/lists/subscribe with the token in X-Contact-Token. The server only answers that for origins the
 * list allows — in the BizSites admin, Lists → the list → "Other sites": https://shinylib.net and
 * https://www.shinylib.net. The confirmation email and its links come from `api`'s domain.
 *
 * The form starts hidden and shows itself once the token request succeeds, so a list that isn't set up yet
 * (or `npm run dev`, whose localhost origin isn't allowed) shows nothing rather than a broken form.
 */
interface Props {
  list?: string;
  api?: string;
}

const { list = 'newsletter', api = 'https://shinysoft.biz' } = Astro.props;
---

<div class="newsletter-signup not-content" data-list={list} data-api={api} hidden>
  <p class="newsletter-title">.NET in production, once a month</p>
  <p class="newsletter-body">
    Shiny releases, MAUI, modernization, Azure and AI: what's worth knowing when it has to ship. No spam,
    unsubscribe any time.
  </p>
  <form class="newsletter-form">
    <input name="email" type="email" required placeholder="you@example.com" aria-label="Email address" autocomplete="email" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="newsletter-status" role="status"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.newsletter-signup').forEach(async (root) => {
    const form = root.querySelector('form')!;
    const status = root.querySelector<HTMLElement>('.newsletter-status')!;
    const api = root.dataset.api ?? '';

    const token = async (): Promise<string | null> => {
      try {
        const res = await fetch(`${api}/api/contact/token`, { cache: 'no-store' });
        return res.ok ? (await res.json()).token : null;
      } catch {
        return null;
      }
    };

    // Not reachable, or this origin isn't allowed on the list yet: leave the form hidden.
    if (!(await token())) return;
    root.hidden = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button')!;
      button.disabled = true;
      status.textContent = 'Sending…';
      try {
        const res = await fetch(`${api}/api/lists/subscribe`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Contact-Token': (await token()) ?? '' },
          body: JSON.stringify({ list: root.dataset.list, email: form.email.value, page: location.pathname }),
        });
        status.textContent = res.ok
          ? 'Almost done: check your inbox for the confirmation link.'
          : res.status === 429
            ? 'Too many signups right now. Try again later.'
            : "That didn't work. Check the address and try again.";
        if (res.ok) form.reset();
      } catch {
        status.textContent = "That didn't work. Try again in a moment.";
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .newsletter-signup {
    margin-top: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
  }

  .newsletter-signup[hidden] {
    display: none;
  }

  .newsletter-title {
    margin: 0;
    font-weight: 600;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }

  .newsletter-body {
    margin: 0.35rem 0 0.75rem;
    color: var(--sl-color-gray-2);
  }

  .newsletter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .newsletter-form input {
    flex: 1 1 14rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }

  .newsletter-form button {
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .newsletter-form button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .newsletter-status {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>
