---
import { localeHref } from '../i18n/url';

export interface Props {
	message?: string;
}

const { message } = Astro.props as Props;
const t = Astro.locals.t;
---

:::cauton
{message || t('androidForegroundService.message')}

{t('androidForegroundService.moreInfo')} <a href={localeHref('/client/core/android-foreground', Astro.locals.starlightRoute?.locale)}>{t('androidForegroundService.linkText')}</a>
:::
