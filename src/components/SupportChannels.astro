---
/**
 * SupportChannels — the four ways to reach the project, as cards.
 *
 * Used by /foundation/support. Each card says what the channel is *for* and
 * what to expect back, because the most useful thing a support page does is
 * set expectations before someone spends effort writing in the wrong place.
 */

const channels = [
  {
    key: 'discussions',
    name: 'GitHub Discussions',
    href: 'https://github.com/orgs/shinyorg/discussions',
    cta: 'Open Discussions',
    use: 'Questions, design feedback, and "which library should I use?"',
    body: 'The org-wide forum, shared by every Shiny library. Best for anything that spans more than one repo, or where you are not yet sure whether you have found a bug.',
    expect: 'Answered by maintainers and other users. No response time guarantee.',
    icon: 'discussions',
  },
  {
    key: 'discord',
    name: 'Discord',
    href: 'https://mauiverse.net/discord/',
    cta: 'Join on MAUIverse',
    use: 'Quick questions and realtime chat',
    body: 'Shiny lives in the MAUIverse Discord alongside the wider .NET MAUI community — good for a fast sanity check, sharing what you are building, or a conversation that would be slow over issues.',
    expect: 'Casual and realtime. Chat scrolls away, so anything worth keeping belongs in Discussions or an issue.',
    icon: 'discord',
  },
  {
    key: 'issues',
    name: 'GitHub Issues',
    href: '#file-an-issue-in-the-right-repo',
    cta: 'Find the right repo',
    use: 'Bugs, crashes, and concrete feature requests',
    body: 'Each library has its own repo, so an issue needs to land in the right one. The picker below maps what you are using to where it lives.',
    expect: 'A repro (or a failing sample) is what turns a report into a fix.',
    icon: 'issues',
  },
  {
    key: 'commercial',
    name: 'Sponsorship & commercial',
    href: 'https://sponsor.shinylib.net',
    cta: 'Sponsor the project',
    use: 'Priority attention, consulting, private work',
    body: 'Shiny is maintained in the open. Sponsorship funds that work; ShinySoft Technologies handles consulting, private support, and anything that cannot be discussed in public.',
    expect: 'Sponsors are prioritised. For commercial enquiries, see ShinySoft.',
    icon: 'heart',
    secondary: { label: 'ShinySoft Technologies', href: 'https://shinysoft.biz' },
  },
];

const icons = {
  discussions:
    '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.7-4.6A8.2 8.2 0 0 1 3.6 11.5 8.4 8.4 0 0 1 12.3 3 8.4 8.4 0 0 1 21 11.5Z"/>',
  discord:
    '<path d="M19.3 5.4A16.3 16.3 0 0 0 15.4 4l-.3.5a12.9 12.9 0 0 1 3.5 1.6 15.7 15.7 0 0 0-13.2 0A12.9 12.9 0 0 1 8.9 4.5L8.6 4a16.3 16.3 0 0 0-3.9 1.4C1.9 9.5 1.2 13.5 1.6 17.4A16.4 16.4 0 0 0 6.5 20l1-1.5c-.8-.3-1.6-.7-2.3-1.2l.6-.4a11.4 11.4 0 0 0 10.4 0l.6.4c-.7.5-1.5.9-2.3 1.2l1 1.5a16.4 16.4 0 0 0 4.9-2.6c.5-4.5-.6-8.5-2.6-12Zm-11 9.2c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm7.4 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"/>',
  issues:
    '<path d="M12 1C5.9 1 1 5.9 1 12s4.9 11 11 11 11-4.9 11-11S18.1 1 12 1ZM2.5 12a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0Zm9.5 2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/>',
  heart:
    '<path d="M12 21s-7.5-4.9-9.6-9A5.4 5.4 0 0 1 12 6.1 5.4 5.4 0 0 1 21.6 12c-2.1 4.1-9.6 9-9.6 9Z"/>',
};
---

<div class="support-channels not-content">
  {channels.map((c) => (
    <div class={`channel channel--${c.key}`}>
      <div class="channel-head">
        <span class="channel-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" set:html={icons[c.icon]} />
        </span>
        <h3 class="channel-name">{c.name}</h3>
      </div>

      <p class="channel-use">{c.use}</p>
      <p class="channel-body">{c.body}</p>
      <p class="channel-expect"><strong>What to expect:</strong> {c.expect}</p>

      <div class="channel-actions">
        <a
          class="channel-cta"
          href={c.href}
          {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {c.cta}
        </a>
        {c.secondary && (
          <a class="channel-secondary" href={c.secondary.href} target="_blank" rel="noopener noreferrer">
            {c.secondary.label}
          </a>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  .support-channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .channel {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.15rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background-color: var(--sl-color-bg-nav);
  }

  /* A hairline of brand colour along the top edge, one hue per channel, so the
     four read as a set without four competing card backgrounds. */
  .channel::before {
    content: '';
    display: block;
    height: 3px;
    margin: -1.1rem -1.15rem 1rem;
    border-radius: 0.75rem 0.75rem 0 0;
    background: var(--channel-accent);
  }

  .channel--discussions { --channel-accent: var(--shiny-purple-vivid); }
  .channel--discord { --channel-accent: #5865f2; }
  .channel--issues { --channel-accent: var(--shiny-green-vivid); }
  .channel--commercial { --channel-accent: #e5484d; }

  .channel-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .channel-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--channel-accent) 14%, transparent);
    color: var(--channel-accent);
  }

  .channel-name {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
  }

  .channel-use {
    margin: 0 0 0.5rem;
    color: var(--sl-color-white);
    font-size: 0.92rem;
    font-weight: 650;
  }

  .channel-body {
    margin: 0 0 0.7rem;
    color: var(--sl-color-gray-2);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .channel-expect {
    /* Pushed to the bottom so the CTAs line up across cards of unequal text. */
    margin: auto 0 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .channel-expect strong {
    color: var(--sl-color-gray-2);
  }

  .channel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }

  .channel-cta {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.95rem;
    border-radius: 0.5rem;
    background: var(--channel-accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .channel-cta:hover {
    color: #fff;
    filter: brightness(1.08);
  }

  .channel-secondary {
    color: var(--sl-color-text-accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .channel-secondary:hover {
    text-decoration: underline;
  }
</style>
